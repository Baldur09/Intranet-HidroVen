    <script>
      (function() {
        try {
          const dateElem = document.getElementById('current-live-date');
          if (dateElem) {
            const today = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const formatted = today.toLocaleDateString('es-VE', options);
            dateElem.textContent = formatted.charAt(0).toUpperCase() + formatted.slice(1);
          }
        } catch (e) {
          console.error(e);
        }

        const slides = [
          {
            title: "Embalse Los Quediches",
            desc: "Cota actual en nivel óptimo de bombeo. Abastecimiento sostenido a la red alta de Carora y zonas aledañas.",
            location: "ESTADO LARA • SISTEMA HIDRÁULICO OCCIDENTE",
            status: "Operación Normal",
            metric: "84.2%",
            alt: "Photographic drone view of Venezuelan hydraulic infrastructure Embalse Los Quediches reservoir..."
          },
          {
            title: "Planta Potabilizadora Ciudad Barquisimeto",
            desc: "Proceso de clarificación y filtración rápida operando a 2.400 litros por segundo bajo estricto control fisicoquímico.",
            location: "ESTADO LARA • PLANTA CENTRAL MACUTO",
            status: "99.1% Eficiencia",
            metric: "2.400 L/s",
            alt: "Clean modern industrial architectural view of a water treatment clarification plant..."
          },
          {
            title: "Estación de Bombeo y Acueducto Metropolitano",
            desc: "Monitoreo telemetrado de motores de 3.000 HP y sistemas de protección contra golpe de ariete.",
            location: "SISTEMA REGIONAL DEL CENTRO • ETAPA II",
            status: "Guardia 24/7",
            metric: "98.5%",
            alt: "Modern hydraulic pumping station hall with massive blue industrial water pumps..."
          }
        ];

        let currentSlideIdx = 0;
        const heroSlide = document.getElementById('hero-carousel-slide');
        const slideTitle = document.getElementById('slide-title');
        const slideDesc = document.getElementById('slide-desc');
        const slideLocation = document.getElementById('slide-location');
        const slideStatus = document.getElementById('slide-status');
        const slideMetric = document.getElementById('slide-metric');
        const indicators = document.querySelectorAll('.slide-indicator');

        function updateSlide(index) {
          currentSlideIdx = (index + slides.length) % slides.length;
          const data = slides[currentSlideIdx];

          if (heroSlide) {
            heroSlide.style.opacity = '0.4';
            setTimeout(() => {
              heroSlide.setAttribute('data-alt', data.alt);
              if (slideTitle) slideTitle.textContent = data.title;
              if (slideDesc) slideDesc.textContent = data.desc;
              if (slideLocation) slideLocation.textContent = data.location;
              if (slideStatus) slideStatus.textContent = data.status;
              if (slideMetric) slideMetric.textContent = data.metric;
              heroSlide.style.opacity = '1';
            }, 180);
          }

          indicators.forEach((ind, i) => {
            if (i === currentSlideIdx) {
              ind.classList.remove('w-3', 'bg-surface-container-highest');
              ind.classList.add('w-8', 'bg-primary');
            } else {
              ind.classList.remove('w-8', 'bg-primary');
              ind.classList.add('w-3', 'bg-surface-container-highest');
            }
          });
        }

        const prevBtn = document.getElementById('prev-slide-btn');
        const nextBtn = document.getElementById('next-slide-btn');

        if (prevBtn) prevBtn.addEventListener('click', () => updateSlide(currentSlideIdx - 1));
        if (nextBtn) nextBtn.addEventListener('click', () => updateSlide(currentSlideIdx + 1));

        indicators.forEach((indicator) => {
          indicator.addEventListener('click', (e) => {
            const idx = parseInt(e.target.getAttribute('data-index') || '0', 10);
            updateSlide(idx);
          });
        });

        setInterval(() => {
          updateSlide(currentSlideIdx + 1);
        }, 8000);
      })();
    </script>
  </main>

