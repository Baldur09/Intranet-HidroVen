<!DOCTYPE html>
<html lang="es">
<%- include('partials/head', { titulo: 'Inicio | Portal Intranet', headStyles: 'styles/site' }) %>
<body class="bg-background font-body-md text-on-surface antialiased min-h-screen overflow-y-auto">

  <!-- INCLUSIÓN DINÁMICA DEL ENCABEZADO -->
  <%- include('partials/header') %>
  
  <main class="w-full pt-20 bg-background min-h-screen">
    <div class="flex flex-col w-full">
      <div class="max-w-[1280px] w-full mx-auto px-margin-mobile lg:px-margin space-y-space-xl pb-space-xl">
        
        <!-- Top Welcome & Operational Telemetry Strip -->
        <div class="pt-6">
          <div class="bg-surface-container-lowest rounded-xl p-space-md lg:p-space-lg shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-space-md relative overflow-hidden">
            <div class="absolute -right-12 -top-12 w-48 h-48 rounded-full bg-secondary-container/10 pointer-events-none blur-2xl"></div>
            <div class="space-y-1 relative z-10">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-secondary-fixed/50 text-on-secondary-fixed-variant font-label-caps text-label-caps font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-secondary animate-pulse"></span>
                  RED OPERACIONAL NACIONAL
                </span>
                <span class="text-tertiary font-label-md text-label-md hidden sm:inline-block">•</span>
                <span class="font-label-md text-label-md text-tertiary" id="current-live-date">Viernes, 23 de octubre de 2026</span>
              </div>
              <h1 class="font-headline-lg text-headline-lg text-on-surface">
                Bienvenido al Portal Corporativo <span class="text-primary font-bold">HidroVen Lara</span>
              </h1>
              <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">
                Centro neurálgico de gestión, sistemas administrativos, monitoreo hidrológico e interconexión del personal del sector agua.
              </p>
            </div>
            <div class="flex flex-wrap sm:flex-nowrap items-center gap-space-sm relative z-10">
              <div class="bg-surface-container-low px-space-md py-2.5 rounded-lg flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed">
                  <span class="material-symbols-outlined text-[20px]" translate="no">water_drop</span>
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="font-headline-sm text-headline-sm text-on-surface leading-tight font-bold">99.8%</span>
                    <span class="w-2 h-2 rounded-full bg-secondary"></span>
                  </div>
                  <span class="font-label-caps text-label-caps text-tertiary">Disponibilidad de Red</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Hero Facility Showcase & Operational News Ticker -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-md">
          <!-- Carrusel de Fotos Dinámico -->
          <div class="lg:col-span-12">
            <%- include('partials/carrusel-inicio', { slides: typeof slides !== 'undefined' ? slides : [] }) %>
          </div>

          <!-- Live Broadcast / Operational Ticker & Priority Notices -->
          <div class="flex flex-col gap-space-md lg:col-span-12">
            <!-- Zimbra Direct Fast Track Card -->
            <a class="bg-primary-container text-on-primary-container rounded-xl p-space-md shadow-sm hover:shadow-md transition-all flex items-center justify-between group" href="https://correo.hidroven.gob.ve" rel="noopener" target="_blank">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-lg bg-surface-container-lowest text-primary flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform">
                  <span class="material-symbols-outlined text-[24px]" translate="no">forward_to_inbox</span>
                </div>
                <div>
                  <div class="font-headline-sm text-headline-sm text-on-primary font-bold">Buzón Zimbra</div>
                  <div class="font-body-sm text-body-sm text-on-primary/80">Acceso oficial a mensajería corporativa</div>
                </div>
              </div>
              <span class="material-symbols-outlined text-on-primary group-hover:translate-x-1 transition-transform" translate="no">arrow_forward</span>
            </a>
          </div>
        </div>

        <!-- Quick Action Pillar Cards (Accesos Rápidos) -->
        <div>
          <div class="flex items-center justify-between mb-space-md">
            <div>
              <span class="font-label-caps text-label-caps text-tertiary uppercase">Rutas de Navegación Principal</span>
              <h2 class="font-headline-md text-headline-md text-on-surface font-bold">Accesos Rápidos</h2>
            </div>
            <span class="font-label-md text-label-md text-tertiary hidden sm:inline-block">Seleccione para explorar módulos</span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
            <!-- Pillar 1: Apps -->
            <a class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex flex-col justify-between group cursor-pointer border border-surface-container" href="/apps">
              <div>
                <div class="w-12 h-12 rounded-xl bg-surface-container-low text-primary flex items-center justify-center mb-space-md group-hover:bg-primary group-hover:text-on-primary transition-all">
                  <span class="material-symbols-outlined text-[28px]" translate="no">apps</span>
                </div>
                <span class="font-label-caps text-label-caps text-secondary font-bold">Servicios Digitales</span>
                <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold mt-1">Aplicaciones Corporativas</h3>
                <p class="font-body-md text-body-md text-on-surface-variant mt-2">
                  Acceso unificado a nómina, comprobantes digitales de pago, sistemas administrativos SIA y plataformas comerciales.
                </p>
              </div>
              <div class="pt-space-md flex items-center gap-1 text-primary font-label-lg text-label-lg group-hover:gap-2 transition-all">
                <span>Abrir catálogo de aplicaciones</span>
                <span class="material-symbols-outlined text-[18px]" translate="no">arrow_forward</span>
              </div>
            </a>
            <!-- Pillar 2: Phone Directory -->
            <a class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between group" href="/directorio">
              <div>
                <div class="w-12 h-12 rounded-xl bg-surface-container-low text-primary flex items-center justify-center mb-space-md group-hover:bg-primary group-hover:text-on-primary transition-all">
                  <span class="material-symbols-outlined text-[28px]" translate="no">contact_phone</span>
                </div>
                <span class="font-label-caps text-label-caps text-secondary font-bold">Comunicaciones Internas</span>
                <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold mt-1">Directorio Telefónico</h3>
                <p class="font-body-md text-body-md text-on-surface-variant mt-2">
                  Guía telefónica de extensiones directas, gerencias técnicas, despachos centrales y filiales hidrológicas regionales.
                </p>
              </div>
              <div class="pt-space-md flex items-center gap-1 text-primary font-label-lg text-label-lg group-hover:gap-2 transition-all">
                <span>Consultar extensiones activas</span>
                <span class="material-symbols-outlined text-[18px]" translate="no">arrow_forward</span>
              </div>
            </a>
            <!-- Pillar 3: Documentation -->
            <a class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between group" href="#documentacion">
              <div>
                <div class="w-12 h-12 rounded-xl bg-surface-container-low text-primary flex items-center justify-center mb-space-md group-hover:bg-primary group-hover:text-on-primary transition-all">
                  <span class="material-symbols-outlined text-[28px]" translate="no">folder_special</span>
                </div>
                <span class="font-label-caps text-label-caps text-secondary font-bold">Repositorio Normativo</span>
                <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold mt-1">Documentación Organizacional</h3>
                <p class="font-body-md text-body-md text-on-surface-variant mt-2">
                  Formatos de Recursos Humanos, manuales de procedimientos operativos, decretos del sector y gacetas internas.
                </p>
              </div>
              <div class="pt-space-md flex items-center gap-1 text-primary font-label-lg text-label-lg group-hover:gap-2 transition-all">
                <span>Descargar manuales y guías</span>
                <span class="material-symbols-outlined text-[18px]" translate="no">arrow_forward</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Conexiones y Enlaces de Interés -->
        <div class="space-y-space-md" id="enlaces-interes" style="scroll-margin-top: 6rem;">
          <div>
            <span class="font-label-caps text-label-caps text-tertiary uppercase">Ecosistema Institucional</span>
            <h2 class="font-headline-md text-headline-md text-on-surface font-bold">Enlaces de Interés</h2>
          </div>
          <div class="flex flex-col gap-space-md">
            
            <!-- Category 1: Banca Nacional -->
            <div class="rounded-xl shadow-sm bg-surface-container-lowest p-space-md lg:p-space-lg flex flex-col gap-space-md border border-outline-variant/30">
              <div class="space-y-1">
                <div class="flex items-center gap-2.5">
                  <span class="material-symbols-outlined text-[22px] text-primary" translate="no">account_balance</span>
                  <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Banca Nacional</h3>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Plataformas financieras para pago de beneficios salariales, fideicomisos y trámites de tesorería corporativa.</p>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- BDV -->
                <a class="px-4 py-4 rounded-xl bg-surface-container-low/70 hover:bg-surface-container transition-colors flex items-center gap-3.5 border border-outline-variant/15 group" href="https://www.bancodevenezuela.com" rel="noopener" target="_blank">
                  <div class="w-12 h-12 rounded-xl bg-white border border-outline-variant/30 flex items-center justify-center p-2 flex-shrink-0">
                    <img src="https://unavatar.io/bancodevenezuela.com" alt="BDV" class="w-full h-full object-contain" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                    <span class="hidden font-headline-sm text-label-caps font-bold text-primary">BDV</span>
                  </div>
                  <div class="min-w-0">
                    <div class="font-label-md text-label-md text-on-surface font-bold group-hover:text-primary transition-colors">Bco. Venezuela</div>
                    <div class="font-body-sm text-body-sm text-outline">BDVenlínea</div>
                  </div>
                </a>
                <!-- BBVA Provincial -->
                <a class="px-4 py-4 rounded-xl bg-surface-container-low/70 hover:bg-surface-container transition-colors flex items-center gap-3.5 border border-outline-variant/15 group" href="https://www.provincial.com" rel="noopener" target="_blank">
                  <div class="w-12 h-12 rounded-xl bg-white border border-outline-variant/30 flex items-center justify-center p-2 flex-shrink-0">
                    <img src="https://unavatar.io/provincial.com" alt="BP" class="w-full h-full object-contain" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                    <span class="hidden font-headline-sm text-label-caps font-bold text-secondary">BP</span>
                  </div>
                  <div class="min-w-0">
                    <div class="font-label-md text-label-md text-on-surface font-bold group-hover:text-primary transition-colors">BBVA Provincial</div>
                    <div class="font-body-sm text-body-sm text-outline">Provinet</div>
                  </div>
                </a>
                <!-- Banesco -->
                <a class="px-4 py-4 rounded-xl bg-surface-container-low/70 hover:bg-surface-container transition-colors flex items-center gap-3.5 border border-outline-variant/15 group" href="https://www.banesco.com" rel="noopener" target="_blank">
                  <div class="w-12 h-12 rounded-xl bg-white border border-outline-variant/30 flex items-center justify-center p-2 flex-shrink-0">
                    <img src="https://unavatar.io/banesco.com" alt="BAN" class="w-full h-full object-contain" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                    <span class="hidden font-headline-sm text-label-caps font-bold text-primary">BAN</span>
                  </div>
                  <div class="min-w-0">
                    <div class="font-label-md text-label-md text-on-surface font-bold group-hover:text-primary transition-colors">Banesco</div>
                    <div class="font-body-sm text-body-sm text-outline">BanescOnline</div>
                  </div>
                </a>
              </div>
              <div class="pt-2 border-t border-surface-container flex items-center justify-between text-outline font-body-sm text-body-sm">
                <span>Operaciones de Nómina Centralizada</span>
                <a class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-primary/10 hover:bg-primary text-primary hover:text-on-primary transition-all font-label-md text-label-md font-semibold cursor-pointer" href="/bancos">
                  <span>Abrir catálogo de bancos</span>
                  <span class="material-symbols-outlined text-[16px]" translate="no">arrow_forward</span>
                </a>
              </div>
            </div>

            <!-- Category 2: Organismos Gubernamentales -->
            <div class="rounded-xl shadow-sm bg-surface-container-lowest p-space-md lg:p-space-lg flex flex-col gap-space-md border border-outline-variant/30">
              <div class="space-y-1">
                <div class="flex items-center gap-2.5">
                  <span class="material-symbols-outlined text-[22px] text-primary" translate="no">assured_workload</span>
                  <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Organismos Gubernamentales</h3>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Enlaces institucionales oficiales del Poder Popular de Atención de las Aguas y entes de control fiscal.</p>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- MinAguas -->
                <a class="px-4 py-4 rounded-xl bg-surface-container-low/70 hover:bg-surface-container transition-colors flex items-center gap-3.5 border border-outline-variant/15 group" href="http://minaguas.gob.ve" rel="noopener" target="_blank">
                  <div class="w-12 h-12 rounded-xl bg-white border border-outline-variant/30 flex items-center justify-center p-2 flex-shrink-0">
                    <img src="https://unavatar.io/minaguas.gob.ve" alt="MA" class="w-full h-full object-contain" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                    <span class="hidden font-headline-sm text-label-caps font-bold text-primary">MA</span>
                  </div>
                  <div class="min-w-0">
                    <div class="font-label-md text-label-md text-on-surface font-bold group-hover:text-primary transition-colors">MinAguas</div>
                    <div class="font-body-sm text-body-sm text-outline">Órgano Rector Nacional</div>
                  </div>
                </a>
                <!-- SENIAT Portal -->
                <a class="px-4 py-4 rounded-xl bg-surface-container-low/70 hover:bg-surface-container transition-colors flex items-center gap-3.5 border border-outline-variant/15 group" href="https://seniatenlinea.seniat.gob.ve/" rel="noopener" target="_blank">
                  <div class="w-12 h-12 rounded-xl bg-white border border-outline-variant/30 flex items-center justify-center p-2 flex-shrink-0">
                    <img src="/images/logos/logo-1794945947390-20901.jpg" alt="SN" class="w-full h-full object-contain" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                    <span class="hidden font-headline-sm text-label-caps font-bold text-primary">SN</span>
                  </div>
                  <div class="min-w-0">
                    <div class="font-label-md text-label-md text-on-surface font-bold group-hover:text-primary transition-colors">SENIAT Portal</div>
                    <div class="font-body-sm text-body-sm text-outline">Declaraciones Tributarias</div>
                  </div>
                </a>
                <!-- IVSS Seguro Social -->
                <a class="px-4 py-4 rounded-xl bg-surface-container-low/70 hover:bg-surface-container transition-colors flex items-center gap-3.5 border border-outline-variant/15 group" href="http://www.ivss.gob.ve" rel="noopener" target="_blank">
                  <div class="w-12 h-12 rounded-xl bg-white border border-outline-variant/30 flex items-center justify-center p-2 flex-shrink-0">
                    <img src="https://unavatar.io/ivss.gob.ve" alt="IV" class="w-full h-full object-contain" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';">
                    <span class="hidden font-headline-sm text-label-caps font-bold text-primary">IV</span>
                  </div>
                  <div class="min-w-0">
                    <div class="font-label-md text-label-md text-on-surface font-bold group-hover:text-primary transition-colors">IVSS Seguro Social</div>
                    <div class="font-body-sm text-body-sm text-outline">Cuenta Individual y Solvencias</div>
                  </div>
                </a>
              </div>
              <div class="pt-2 border-t border-surface-container flex items-center justify-between text-outline font-body-sm text-body-sm">
                <span>Marco Legal &amp; Regulaciones Sectoriales</span>
                <a class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-primary/10 hover:bg-primary text-primary hover:text-on-primary transition-all font-label-md text-label-md font-semibold cursor-pointer" href="/organismos">
                  <span>Abrir catálogo de organismos</span>
                  <span class="material-symbols-outlined text-[16px]" translate="no">arrow_forward</span>
                </a>
              </div>
            </div>

            <!-- Category 3 & 4: Universidades e Institutos / Medios y Difusión Sectorial -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-space-md">
              <!-- Universidades e Institutos -->
              <div class="rounded-xl shadow-sm bg-surface-container-lowest p-space-md lg:p-space-lg flex flex-col justify-between gap-space-md border border-outline-variant/30">
                <div class="space-y-space-md">
                  <div class="space-y-1">
                    <div class="flex items-center gap-2.5">
                      <span class="material-symbols-outlined text-[22px] text-primary" translate="no">school</span>
                      <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Universidades&nbsp;</h3>
                    </div>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Convenios de profesionalización técnica en ingeniería sanitaria, hidrología y gestión ambiental.</p>
                  </div>
                  <div class="space-y-2">
                    <div class="p-3.5 rounded-lg bg-surface-container-low/70 border border-outline-variant/15 flex items-center justify-between gap-2">
                      <div>
                        <div class="font-label-md text-label-md text-on-surface font-bold">Universidad Central de Venezuela (UCV)</div>
                        <div class="font-body-sm text-body-sm text-outline">Postgrado de Hidráulica e Ingeniería Sanitaria</div>
                      </div>
                      <span class="px-2.5 py-0.5 rounded-full bg-secondary-fixed/50 text-on-secondary-fixed-variant font-label-caps text-label-caps font-semibold shrink-0">Convenio Activo</span>
                    </div>
                    <div class="p-3.5 rounded-lg bg-surface-container-low/70 border border-outline-variant/15 flex items-center justify-between gap-2">
                      <div>
                        <div class="font-label-md text-label-md text-on-surface font-bold">Universidad Simón Bolívar (USB)</div>
                        <div class="font-body-sm text-body-sm text-outline">Laboratorio de Mecánica de Fluidos y Presas</div>
                      </div>
                      <span class="px-2.5 py-0.5 rounded-full bg-surface-container-high text-tertiary font-label-caps text-label-caps font-semibold shrink-0">Pasantías</span>
                    </div>
                  </div>
                </div>
                <div class="pt-2">
                  <a class="inline-flex items-center gap-1 font-label-md text-label-md text-primary font-bold hover:underline" href="/universidades">
                    <span>Ver convocatorias de becas para personal</span>
                    <span class="material-symbols-outlined text-[16px]" translate="no">arrow_forward</span>
                  </a>
                </div>
              </div>

              <!-- Medios y Difusión Sectorial -->
              <div class="rounded-xl shadow-sm bg-surface-container-lowest p-space-md lg:p-space-lg flex flex-col justify-between gap-space-md border border-outline-variant/30">
                <div class="space-y-space-md">
                  <div class="space-y-1">
                    <div class="flex items-center gap-2.5">
                      <span class="material-symbols-outlined text-[22px] text-primary" translate="no">newspaper</span>
                      <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Medios de Comunicación</h3>
                    </div>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Boletines informativos de gestión pública del agua, sala de prensa y cobertura de obras nacionales.</p>
                  </div>
                  <div class="space-y-2">
                    <div class="p-3.5 rounded-lg bg-surface-container-low/70 border border-outline-variant/15 flex items-center justify-between gap-3">
                      <div class="flex items-center gap-3 min-w-0">
                        <div class="w-9 h-9 rounded-lg bg-primary-fixed flex items-center justify-center text-primary shrink-0">
                          <span class="material-symbols-outlined text-[18px]" translate="no">campaign</span>
                        </div>
                        <div class="min-w-0">
                          <div class="font-label-md text-label-md text-on-surface font-bold truncate">Boletín Hidrológico Semanal (N° 108)</div>
                          <div class="font-body-sm text-body-sm text-outline truncate">Balance hídrico de embalses y cuencas priorizadas</div>
                        </div>
                      </div>
                      <span class="px-2.5 py-0.5 rounded-full bg-surface-container-high text-tertiary font-label-caps text-label-caps font-semibold shrink-0">PDF</span>
                    </div>
                    <div class="p-3.5 rounded-lg bg-surface-container-low/70 border border-outline-variant/15 flex items-center justify-between gap-3">
                      <div class="flex items-center gap-3 min-w-0">
                        <div class="w-9 h-9 rounded-lg bg-primary-fixed flex items-center justify-center text-primary shrink-0">
                          <span class="material-symbols-outlined text-[18px]" translate="no">podcasts</span>
                        </div>
                        <div class="min-w-0">
                          <div class="font-label-md text-label-md text-on-surface font-bold truncate">Podcast "Gota a Gota" HidroVen</div>
                          <div class="font-body-sm text-body-sm text-outline truncate">Episodio 24: Tecnologías de tratamiento en potabilizadoras</div>
                        </div>
                      </div>
                      <span class="px-2.5 py-0.5 rounded-full bg-primary text-on-primary font-label-caps text-label-caps font-semibold shrink-0">Audio</span>
                    </div>
                  </div>
                </div>
                <div class="pt-2">
                  <a class="inline-flex items-center gap-1 font-label-md text-label-md text-primary font-bold hover:underline" href="/medios">
                    <span>Visitar Sala de Prensa y Multimedia</span>
                    <span class="material-symbols-outlined text-[16px]" translate="no">arrow_forward</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <script>
      (function() {
        try {
          const dateElem = document.getElementById('current-live-date');
          if (dateElem) {
            const today = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const formatted = today.toLocaleDateString('es-VE', options);
            dateElem.textContent = formatted.charAt(0).toUpperCase() + formatted.slice(1);
          }
        } catch (e) {
          console.error(e);
        }
      })();
    </script>
  </main>

