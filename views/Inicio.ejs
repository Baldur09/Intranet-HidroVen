<body class="bg-background font-body-md text-on-surface antialiased">

  <!-- INCLUSIÓN DINÁMICA DEL ENCABEZADO -->
  
  <%- include('partials/header') %>

  <main class="w-full pt-20 bg-background min-h-screen">
    <div class="flex flex-col w-full">
      <div class="max-w-[1280px] w-full mx-auto px-margin-mobile lg:px-margin space-y-space-xl pb-space-xl">
        
        <!-- Top Welcome & Operational Telemetry Strip -->
        <div class="pt-6">
          <div class="bg-surface-container-lowest rounded-xl p-space-md lg:p-space-lg shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-space-md relative overflow-hidden">
            <div class="absolute -right-12 -top-12 w-48 h-48 rounded-full bg-secondary-container/10 pointer-events-none blur-2xl"></div>
            <div class="space-y-1 relative z-10">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-secondary-fixed/50 text-on-secondary-fixed-variant font-label-caps text-label-caps font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-secondary animate-pulse"></span>
                  RED OPERACIONAL NACIONAL
                </span>
                <span class="text-tertiary font-label-md text-label-md hidden sm:inline-block">•</span>
                <span class="font-label-md text-label-md text-tertiary" id="current-live-date">Viernes, 23 de octubre de 2026</span>
              </div>
              <h1 class="font-headline-lg text-headline-lg text-on-surface">
                Bienvenido al Portal Corporativo <span class="text-primary font-bold">HidroVen Lara</span>
              </h1>
              <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">
                Centro neurálgico de gestión, sistemas administrativos, monitoreo hidrológico e interconexión del personal del sector agua.
              </p>
            </div>
            <div class="flex flex-wrap sm:flex-nowrap items-center gap-space-sm relative z-10">
              <div class="bg-surface-container-low px-space-md py-2.5 rounded-lg flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed">
                  <span class="material-symbols-outlined text-[20px]">water_drop</span>
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <span class="font-headline-sm text-headline-sm text-on-surface leading-tight font-bold">99.8%</span>
                    <span class="w-2 h-2 rounded-full bg-secondary"></span>
                  </div>
                  <span class="font-label-caps text-label-caps text-tertiary">Disponibilidad de Red</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Hero Facility Showcase & Operational News Ticker -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-md">
          <!-- Main Visual Showcase (Embalse Los Quediches reference) -->
          <div class="rounded-xl bg-surface-container-lowest overflow-hidden shadow-sm flex flex-col relative group lg:col-span-12">
            <div class="relative h-80 sm:h-96 w-full overflow-hidden">
              <div class="w-full h-full bg-cover bg-center transition-all duration-700 ease-out transform group-hover:scale-105" data-alt="Photographic drone view of Venezuelan hydraulic infrastructure Embalse Los Quediches reservoir..." id="hero-carousel-slide" style="background-image: url(&quot;https://lh3.googleusercontent.com/aida-public/AB6AXuBdTwU31t1t-DkR-cFcktoJ5aw0_u6BlEjvLGlSA4b9FnH18KwvLvfptKdEuK8yTDjEx0vRu1EjsPXNLxL_LJOaSoPtiWc3uOc3aR6RK7n4QSALgTUtlh0O-qjCtdDbxtSLUBTNk1_lslPHeJHypwC87io11SKvG43jzvQ8mqntdYjsnYf9UoRTCH7ZpNBKtaD0-1Qui53gyOb1ZtWe-SaOGmISOBEhRIdvPCxxFztR3_ce8ZqAPBaP&quot;); opacity: 1;">
                <div class="absolute inset-0 bg-gradient-to-t from-on-surface/90 via-on-surface/30 to-transparent"></div>
              </div>
              <!-- Glass Tags -->
              <div class="absolute top-4 left-4 flex flex-wrap gap-2">
                <div class="backdrop-blur-md bg-surface/90 px-3 py-1 rounded-full text-on-surface flex items-center gap-1.5 shadow-sm">
                  <span class="material-symbols-outlined text-[16px] text-primary">pin_drop</span>
                  <span class="font-label-caps text-label-caps text-primary font-bold" id="slide-location">ESTADO LARA • SISTEMA HIDRÁULICO OCCIDENTE</span>
                </div>
                <div class="backdrop-blur-md bg-surface/90 px-3 py-1 rounded-full text-secondary flex items-center gap-1.5 shadow-sm">
                  <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
                  <span class="font-label-caps text-label-caps font-bold" id="slide-status">Operación Normal</span>
                </div>
              </div>
              <!-- Slide Controls -->
              <div class="absolute top-4 right-4 flex items-center gap-1">
                <button aria-label="Anterior" class="w-8 h-8 rounded-full bg-surface/85 backdrop-blur-md text-on-surface hover:bg-surface flex items-center justify-center transition-colors shadow-sm" id="prev-slide-btn">
                  <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                </button>
                <button aria-label="Siguiente" class="w-8 h-8 rounded-full bg-surface/85 backdrop-blur-md text-on-surface hover:bg-surface flex items-center justify-center transition-colors shadow-sm" id="next-slide-btn">
                  <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                </button>
              </div>
              <!-- Caption Container -->
              <div class="absolute bottom-4 left-4 right-4 text-on-primary">
                <div class="backdrop-blur-md bg-on-surface/70 p-space-md rounded-lg flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm">
                  <div>
                    <h2 class="font-headline-md text-headline-md text-surface-container-lowest font-bold" id="slide-title">Embalse Los Quediches</h2>
                    <p class="font-body-sm text-body-sm text-surface-container-high" id="slide-desc">Cota actual en nivel óptimo de bombeo. Abastecimiento sostenido a la red alta de Carora y zonas aledañas.</p>
                  </div>
                  <div class="flex items-center gap-3 shrink-0">
                    <div class="text-right">
                      <div class="font-label-caps text-label-caps text-secondary-fixed">Capacidad Activa</div>
                      <div class="font-headline-sm text-headline-sm text-surface-container-lowest font-bold" id="slide-metric">84.2%</div>
                    </div>
                    <div class="w-12 h-12 rounded-lg bg-primary-container/80 flex items-center justify-center text-on-primary-container">
                      <span class="material-symbols-outlined text-[24px]">waves</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!-- Carousel Micro-indicators -->
            <div class="px-space-md py-3 bg-surface-container-lowest flex items-center justify-between">
              <div class="flex items-center gap-2">
                <button class="slide-indicator h-1.5 rounded-full transition-all w-8 bg-primary" data-index="0"></button>
                <button class="slide-indicator h-1.5 rounded-full transition-all w-3 bg-surface-container-highest" data-index="1"></button>
                <button class="slide-indicator h-1.5 rounded-full transition-all w-3 bg-surface-container-highest" data-index="2"></button>
              </div>
              <span class="font-label-caps text-label-caps text-tertiary">Actualización hidrométrica continua</span>
            </div>
          </div>

          <!-- Live Broadcast / Operational Ticker & Priority Notices -->
          <div class="flex flex-col gap-space-md lg:col-span-12">
            <!-- Zimbra Direct Fast Track Card -->
            <a class="bg-primary-container text-on-primary-container rounded-xl p-space-md shadow-sm hover:shadow-md transition-all flex items-center justify-between group" href="https://correo.hidroven.gob.ve" rel="noopener" target="_blank">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-lg bg-surface-container-lowest text-primary flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform">
                  <span class="material-symbols-outlined text-[24px]">forward_to_inbox</span>
                </div>
                <div>
                  <div class="font-headline-sm text-headline-sm text-on-primary font-bold">Buzón Zimbra</div>
                  <div class="font-body-sm text-body-sm text-on-primary/80">Acceso oficial a mensajería corporativa</div>
                </div>
              </div>
              <span class="material-symbols-outlined text-on-primary group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>
        </div>

        <!-- Quick Action Pillar Cards (Accesos Rápidos) -->
        <div>
          <div class="flex items-center justify-between mb-space-md">
            <div>
              <span class="font-label-caps text-label-caps text-tertiary uppercase">Rutas de Navegación Principal</span>
              <h2 class="font-headline-md text-headline-md text-on-surface font-bold">Accesos Rápidos</h2>
            </div>
            <span class="font-label-md text-label-md text-tertiary hidden sm:inline-block">Seleccione para explorar módulos</span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
            <!-- Pillar 1: Apps -->
            <!-- Pillar 1: Apps (Toda la tarjeta redirige a la pantalla de Apps) -->
            <a class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all flex flex-col justify-between group cursor-pointer border border-surface-container" href="/apps">
              <div>
                <div class="w-12 h-12 rounded-xl bg-surface-container-low text-primary flex items-center justify-center mb-space-md group-hover:bg-primary group-hover:text-on-primary transition-all">
                  <span class="material-symbols-outlined text-[28px]">apps</span>
                </div>
                <span class="font-label-caps text-label-caps text-secondary font-bold">Servicios Digitales</span>
                <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold mt-1">Aplicaciones Corporativas</h3>
                <p class="font-body-md text-body-md text-on-surface-variant mt-2">
                  Acceso unificado a nómina, comprobantes digitales de pago, sistemas administrativos SIA y plataformas comerciales.
                </p>
              </div>
              <div class="pt-space-md flex items-center gap-1 text-primary font-label-lg text-label-lg group-hover:gap-2 transition-all">
                <span>Abrir catálogo de aplicaciones</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </div>
            </a>
            <!-- Pillar 2: Phone Directory -->
            <a class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between group" href="/directorio">
              <div>
                <div class="w-12 h-12 rounded-xl bg-surface-container-low text-primary flex items-center justify-center mb-space-md group-hover:bg-primary group-hover:text-on-primary transition-all">
                  <span class="material-symbols-outlined text-[28px]">contact_phone</span>
                </div>
                <span class="font-label-caps text-label-caps text-secondary font-bold">Comunicaciones Internas</span>
                <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold mt-1">Directorio Telefónico</h3>
                <p class="font-body-md text-body-md text-on-surface-variant mt-2">
                  Guía telefónica de extensiones directas, gerencias técnicas, despachos centrales y filiales hidrológicas regionales.
                </p>
              </div>
              <div class="pt-space-md flex items-center gap-1 text-primary font-label-lg text-label-lg group-hover:gap-2 transition-all">
                <span>Consultar extensiones activas</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </div>
            </a>
            <!-- Pillar 3: Documentation -->
            <a class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between group" href="#documentacion">
              <div>
                <div class="w-12 h-12 rounded-xl bg-surface-container-low text-primary flex items-center justify-center mb-space-md group-hover:bg-primary group-hover:text-on-primary transition-all">
                  <span class="material-symbols-outlined text-[28px]">folder_special</span>
                </div>
                <span class="font-label-caps text-label-caps text-secondary font-bold">Repositorio Normativo</span>
                <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold mt-1">Documentación Organizacional</h3>
                <p class="font-body-md text-body-md text-on-surface-variant mt-2">
                  Formatos de Recursos Humanos, manuales de procedimientos operativos, decretos del sector y gacetas internas.
                </p>
              </div>
              <div class="pt-space-md flex items-center gap-1 text-primary font-label-lg text-label-lg group-hover:gap-2 transition-all">
                <span>Descargar manuales y guías</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </div>
            </a>
          </div>
        </div>

        <!-- Conexiones y Enlaces de Interés -->
        <div class="space-y-space-md" id="enlaces-interes" style="scroll-margin-top: 6rem;">
          <div>
            <span class="font-label-caps text-label-caps text-tertiary uppercase">Ecosistema Institucional</span>
            <h2 class="font-headline-md text-headline-md text-on-surface font-bold">Enlaces de Interés</h2>
          </div>
          <div class="flex flex-col gap-space-md">
            <!-- Category 1: Banca Nacional -->
            <div class="rounded-xl shadow-sm bg-surface-container-lowest p-space-md lg:p-space-lg flex flex-col gap-space-md border border-outline-variant/30">
              <div class="space-y-1">
                <div class="flex items-center gap-2.5">
                  <span class="material-symbols-outlined text-[22px] text-primary">account_balance</span>
                  <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Banca Nacional</h3>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Plataformas financieras para pago de beneficios salariales, fideicomisos y trámites de tesorería corporativa.</p>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-space-sm">
                <!-- BDV -->
                <a class="px-3.5 py-3 rounded-lg bg-surface-container-low/70 hover:bg-surface-container transition-colors flex items-center gap-3 border border-outline-variant/15 group" href="https://www.bancodevenezuela.com" rel="noopener" target="_blank">
                  <span class="font-headline-sm text-label-caps font-bold text-primary bg-primary-fixed/40 px-2 py-1 rounded">BDV</span>
                  <div class="min-w-0">
                    <div class="font-label-md text-label-md text-on-surface font-bold group-hover:text-primary transition-colors">Bco. Venezuela</div>
                    <div class="font-body-sm text-body-sm text-outline">BDVenlínea</div>
                  </div>
                </a>
                <!-- BBVA Provincial -->
                <a class="px-3.5 py-3 rounded-lg bg-surface-container-low/70 hover:bg-surface-container transition-colors flex items-center gap-3 border border-outline-variant/15 group" href="https://www.provincial.com" rel="noopener" target="_blank">
                  <span class="font-headline-sm text-label-caps font-bold text-secondary bg-secondary-fixed/40 px-2 py-1 rounded">BP</span>
                  <div class="min-w-0">
                    <div class="font-label-md text-label-md text-on-surface font-bold group-hover:text-primary transition-colors">BBVA Provincial</div>
                    <div class="font-body-sm text-body-sm text-outline">Provinet</div>
                  </div>
                </a>
                <!-- Banesco -->
                <a class="px-3.5 py-3 rounded-lg bg-surface-container-low/70 hover:bg-surface-container transition-colors flex items-center gap-3 border border-outline-variant/15 group" href="https://www.banesco.com" rel="noopener" target="_blank">
                  <span class="font-headline-sm text-label-caps font-bold text-primary bg-primary-fixed/40 px-2 py-1 rounded">BAN</span>
                  <div class="min-w-0">
                    <div class="font-label-md text-label-md text-on-surface font-bold group-hover:text-primary transition-colors">Banesco</div>
                    <div class="font-body-sm text-body-sm text-outline">BanescOnline</div>
                  </div>
                </a>
              </div>
              <div class="pt-2 border-t border-surface-container flex items-center justify-between text-outline font-body-sm text-body-sm">
                <span>Operaciones de Nómina Centralizada</span>
                <a class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-primary/10 hover:bg-primary text-primary hover:text-on-primary transition-all font-label-md text-label-md font-semibold cursor-pointer" href="#" role="button">
                  <span>Abrir catálogo de bancos</span>
                  <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
              </div>
            </div>

            <!-- Category 2: Organismos Gubernamentales -->
            <div class="rounded-xl shadow-sm bg-surface-container-lowest p-space-md lg:p-space-lg flex flex-col gap-space-md border border-outline-variant/30">
              <div class="space-y-1">
                <div class="flex items-center gap-2.5">
                  <span class="material-symbols-outlined text-[22px] text-primary">account_balance</span>
                  <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Organismos Gubernamentales</h3>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Enlaces institucionales oficiales del Poder Popular de Atención de las Aguas y entes de control fiscal.</p>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
                <!-- MinAguas -->
                <a class="px-4 py-3 rounded-lg bg-surface-container-low/70 hover:bg-surface-container transition-colors flex items-center justify-between border border-outline-variant/15 group" href="http://minaguas.gob.ve" rel="noopener" target="_blank">
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="font-headline-sm text-label-caps font-bold text-primary bg-primary-fixed/40 px-2 py-1 rounded">MA</span>
                    <div class="min-w-0">
                      <div class="font-label-md text-label-md text-on-surface font-bold group-hover:text-primary transition-colors">MinAguas</div>
                      <div class="font-body-sm text-body-sm text-outline">Órgano Rector Nacional</div>
                    </div>
                  </div>
                  <span class="material-symbols-outlined text-outline group-hover:text-primary transition-colors text-[18px]">open_in_new</span>
                </a>
                <!-- SENIAT Portal -->
                <a class="px-4 py-3 rounded-lg bg-surface-container-low/70 hover:bg-surface-container transition-colors flex items-center justify-between border border-outline-variant/15 group" href="https://declaraciones.seniat.gob.ve" rel="noopener" target="_blank">
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="font-headline-sm text-label-caps font-bold text-primary bg-primary-fixed/40 px-2 py-1 rounded">SN</span>
                    <div class="min-w-0">
                      <div class="font-label-md text-label-md text-on-surface font-bold group-hover:text-primary transition-colors">SENIAT Portal</div>
                      <div class="font-body-sm text-body-sm text-outline">Declaraciones Tributarias</div>
                    </div>
                  </div>
                  <span class="material-symbols-outlined text-outline group-hover:text-primary transition-colors text-[18px]">open_in_new</span>
                </a>
                <!-- IVSS Seguro Social -->
                <a class="px-4 py-3 rounded-lg bg-surface-container-low/70 hover:bg-surface-container transition-colors flex items-center justify-between border border-outline-variant/15 group" href="http://www.ivss.gob.ve" rel="noopener" target="_blank">
                  <div class="flex items-center gap-3 min-w-0">
