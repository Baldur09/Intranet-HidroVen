<div class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-inverse-surface/60 backdrop-blur-sm transition-all" id="modal-editar-usuario">
  <div class="bg-surface-container-lowest w-full max-w-xl rounded-xl shadow-xl overflow-hidden flex flex-col max-h-[85vh]">
    <!-- Cabecera Compacta -->
    <div class="px-5 py-3.5 bg-surface-container flex items-center justify-between border-b border-surface-container-high">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-primary text-on-primary flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-[18px]">manage_accounts</span>
        </div>
        <div>
          <h2 class="font-headline-sm text-sm font-bold text-on-surface leading-tight">Editar Usuario Institucional</h2>
          <p class="text-[11px] text-on-surface-variant leading-none">Modifique credenciales, gerencia o estado del empleado.</p>
        </div>
      </div>
      <button aria-label="Cerrar modal" class="p-1 rounded-md hover:bg-surface-container-high text-outline hover:text-on-surface transition-colors cursor-pointer" id="btn-cerrar-modal-editar-x" type="button">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>
    <!-- Buscador Superior Rápido y Compacto -->
    <div class="px-5 py-2.5 bg-surface-container-low border-b border-surface-container-high">
      <div class="relative">
        <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-outline text-[18px]">person_search</span>
        <input autocomplete="off" class="w-full pl-8 pr-8 py-1.5 bg-surface-container-lowest border border-surface-container-high rounded-lg text-body-sm text-on-surface placeholder:text-outline focus:outline-none focus:ring-2 focus:ring-primary border-primary transition-all" id="editar-buscar-usuario" placeholder="Buscar usuario por nombre, cédula o correo..." type="text"/>
        <button class="absolute right-2 top-1/2 -translate-y-1/2 text-outline hover:text-on-surface hidden p-0.5" id="btn-limpiar-busqueda-editar" type="button">
          <span class="material-symbols-outlined text-[16px]">clear</span>
        </button>
        <div class="absolute left-0 right-0 top-full mt-1 bg-surface-container-lowest rounded-xl shadow-lg border border-surface-container-high max-h-48 overflow-y-auto hidden z-20" id="lista-coincidencias-editar"></div>
      </div>
    </div>
    <!-- Formulario de Edición Compacto en 2 Columnas -->
    <form class="p-4 sm:p-5 overflow-y-auto space-y-3.5 flex-1 text-left" id="form-editar-usuario">
      <input id="editar-user-id" type="hidden" value="1"/>
      <!-- Fila 1: Nombres y Apellidos -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1" for="editar-nombres">Nombres <span class="text-error">*</span></label>
          <input class="w-full px-3 py-1.5 bg-surface-container-low rounded-lg text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary border-none transition-all" id="editar-nombres" required="" type="text"/>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1" for="editar-apellidos">Apellidos <span class="text-error">*</span></label>
          <input class="w-full px-3 py-1.5 bg-surface-container-low rounded-lg text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary border-none transition-all" id="editar-apellidos" required="" type="text"/>
        </div>
      </div>
      <!-- Fila 2: Cédula y Correo Institucional -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1" for="editar-cedula">Cédula <span class="text-error">*</span></label>
          <input class="w-full px-3 py-1.5 bg-surface-container-low rounded-lg text-body-sm font-mono text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary border-none transition-all" id="editar-cedula" inputmode="numeric" maxlength="12" required="" type="text"/>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1" for="editar-correo">Correo Institucional <span class="text-error">*</span></label>
          <div class="flex items-center bg-surface-container-low rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-primary transition-all">
            <input class="w-full flex-1 px-3 py-1.5 bg-transparent text-body-sm text-on-surface focus:outline-none border-none" id="editar-correo" maxlength="60" required="" type="text"/>
            <span class="px-3 py-1.5 bg-surface-container text-on-surface-variant text-body-sm font-medium select-none border-l border-surface-container-high">@gmail.com</span>
          </div>
        </div>
      </div>
      <!-- Fila 3: Gerencia y Rol corregidos -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1" for="editar-gerencia">Gerencia / Departamento <span class="text-error">*</span></label>
          <select class="w-full px-3 py-1.5 bg-surface-container-low rounded-lg text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary border-none" id="editar-gerencia" required="">
            <option value="">Seleccione Gerencia...</option>
          </select>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1" for="editar-rol">Rol Institucional <span class="text-error">*</span></label>
          <select class="w-full px-3 py-1.5 bg-surface-container-low rounded-lg text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary border-none" id="editar-rol" required="">
            <option value="">Seleccione Rol...</option>
          </select>
        </div>
      </div>
      <!-- Fila 4: Estado de la Cuenta Slim -->
      <div class="p-3 bg-surface-container-low rounded-lg flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-semibold text-on-surface block">Estado de la Cuenta</span>
          <span class="text-[11px] text-tertiary">Permite acceso al sistema y portal.</span>
        </div>
        <div class="flex items-center gap-3">
          <label class="inline-flex items-center gap-1.5 cursor-pointer">
            <input checked="" class="text-primary focus:ring-primary h-3.5 w-3.5" name="editar-estado-radio" type="radio" value="Activo"/>
            <span class="text-xs font-medium text-on-surface">Activo</span>
          </label>
          <label class="inline-flex items-center gap-1.5 cursor-pointer">
            <input class="text-error focus:ring-error h-3.5 w-3.5" name="editar-estado-radio" type="radio" value="Inactivo"/>
            <span class="text-xs font-medium text-tertiary">Inactivo</span>
          </label>
        </div>
      </div>
    </form>
    <!-- Pie Compacto -->
    <div class="px-5 py-2.5 bg-surface-container flex items-center justify-end gap-2 border-t border-surface-container-high">
      <button class="px-3.5 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container-high text-on-surface transition-colors font-label-md text-xs cursor-pointer" id="btn-cerrar-modal-editar" type="button">
        Cancelar
      </button>
      <button class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-primary hover:bg-primary-container text-on-primary transition-all font-label-md text-xs shadow-sm cursor-pointer" form="form-editar-usuario" id="btn-guardar-edicion" type="submit">
        <span class="material-symbols-outlined text-[16px]">save</span>
        <span class="">Guardar Cambios</span>
      </button>
    </div>
  </div>
</div>