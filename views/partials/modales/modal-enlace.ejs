<div class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-inverse-surface/60 backdrop-blur-sm transition-all" id="modal-enlace">
  <div class="bg-surface-container-lowest w-full max-w-xl rounded-xl shadow-xl overflow-hidden flex flex-col max-h-[85vh]">
    
    <!-- Cabecera Compacta -->
    <div class="px-5 py-3.5 bg-surface-container flex items-center justify-between border-b border-surface-container-high">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-primary text-on-primary flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-[18px]">add_link</span>
        </div>
        <div>
          <h2 id="modal-enlace-titulo-texto" class="font-headline-sm text-sm font-bold text-on-surface leading-tight">Añadir Nuevo Enlace</h2>
          <p class="text-[11px] text-on-surface-variant leading-none">Configure el acceso y ubicación del portal institucional.</p>
        </div>
      </div>
      <button aria-label="Cerrar modal" type="button" data-modal="modal-enlace" class="btn-cerrar-modal p-1 rounded-md hover:bg-surface-container-high text-outline hover:text-on-surface transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <!-- Formulario Compacto -->
    <form id="form-enlace" class="p-4 sm:p-5 overflow-y-auto space-y-3.5 flex-1 text-left">
      <input type="hidden" id="enlace-id-editar" value="">

      <!-- Fila 1: Pantalla y Subdivisión -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1" for="select-enlace-pantalla">Pantalla Destino <span class="text-error">*</span></label>
          <select id="select-enlace-pantalla" required class="w-full px-3 py-1.5 bg-surface-container-low rounded-lg text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary border-none">
            <option value="">Seleccione Pantalla...</option>
          </select>
        </div>

        <div>
          <label class="block text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1" for="select-enlace-subdivision">Subdivisión <span class="text-error">*</span></label>
          <div class="flex items-center gap-1.5">
            <select id="select-enlace-subdivision" required disabled class="flex-1 min-w-0 px-3 py-1.5 bg-surface-container-low rounded-lg text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary border-none disabled:opacity-60">
              <option value="">Elija pantalla...</option>
            </select>
            <button type="button" id="btn-quick-subdivision" title="Crear nueva subdivisión" class="w-8 h-8 rounded-lg bg-secondary-fixed/70 hover:bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center flex-shrink-0 transition-colors cursor-pointer">
              <span class="material-symbols-outlined text-[18px]">add</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Fila 2: Título del Enlace -->
      <div>
        <label class="block text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1" for="input-enlace-titulo">Nombre / Título del Enlace <span class="text-error">*</span></label>
        <input id="input-enlace-titulo" type="text" required placeholder="Ej. Banco de Venezuela, SENIAT, Sistema SIA..." class="w-full px-3 py-1.5 bg-surface-container-low rounded-lg text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary border-none transition-all">
      </div>

      <!-- Fila 3: URL del Sitio -->
      <div>
        <label class="block text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1" for="input-enlace-url">URL del Sitio Web <span class="text-error">*</span></label>
        <input id="input-enlace-url" type="text" required placeholder="https://www.ejemplo.gob.ve" class="w-full px-3 py-1.5 bg-surface-container-low rounded-lg text-body-sm text-on-surface font-mono focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary border-none transition-all">
      </div>

      <!-- Fila 4: Logo y Archivo -->
      <div class="flex flex-col gap-1.5">
        <label class="block text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1" for="input-enlace-logo">URL del Logo (Opcional — automático si queda vacío)</label>
        <input type="hidden" id="enlace-logo-actual" value="">

        <div class="flex items-center gap-3">
          <div class="flex-1 flex flex-col gap-1.5">
            <input class="w-full px-3 py-1.5 bg-surface-container-low rounded-lg text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary border-none transition-all" id="input-enlace-logo" placeholder="Dejar vacío para usar el ícono oficial del sitio web..." type="text">
            
            <div class="flex items-center gap-2">
              <label for="input-enlace-archivo" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-primary text-[11px] font-semibold cursor-pointer transition-colors">
                <span class="material-symbols-outlined text-[14px]">upload_file</span>
                <span>Subir imagen desde PC</span>
              </label>
              <span id="nombre-archivo-logo" class="text-[11px] text-tertiary truncate max-w-[170px]"></span>
              <button type="button" id="btn-quitar-archivo-logo" class="hidden text-error hover:underline text-[11px] font-semibold cursor-pointer">Quitar</button>
              <input id="input-enlace-archivo" name="logoArchivo" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml,image/x-icon" class="hidden">
            </div>
          </div>

          <div class="w-10 h-10 rounded-lg bg-surface-container-high text-primary flex items-center justify-center flex-shrink-0 overflow-hidden p-1" id="preview-logo-box">
            <span class="material-symbols-outlined text-outline text-[20px]">language</span>
          </div>
        </div>
      </div>

      <!-- Fila 5: Estado Slim (idéntico al de modal-editar) -->
      <div class="p-3 bg-surface-container-low rounded-lg flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-semibold text-on-surface block">Estado del Enlace</span>
          <span class="text-[11px] text-tertiary">Disponibilidad visual en el portal.</span>
        </div>
        <div class="flex items-center gap-3">
          <label class="inline-flex items-center gap-1.5 cursor-pointer">
            <input type="radio" name="radio-estado" value="Activo" checked class="text-primary focus:ring-primary h-3.5 w-3.5">
            <span class="text-xs font-medium text-on-surface">Activo</span>
          </label>
          <label class="inline-flex items-center gap-1.5 cursor-pointer">
            <input type="radio" name="radio-estado" value="Inactivo" class="text-error focus:ring-error h-3.5 w-3.5">
            <span class="text-xs font-medium text-tertiary">Inactivo</span>
          </label>
        </div>
      </div>
    </form>

    <!-- Pie Compacto -->
    <div class="px-5 py-2.5 bg-surface-container flex items-center justify-end gap-2 border-t border-surface-container-high">
      <button type="button" data-modal="modal-enlace" class="btn-cerrar-modal px-3.5 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container-high text-on-surface transition-colors font-label-md text-xs cursor-pointer">
        Cancelar
      </button>
      <button type="submit" form="form-enlace" class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-primary hover:bg-primary-container text-on-primary transition-all font-label-md text-xs shadow-sm cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">save</span>
        <span>Guardar Enlace</span>
      </button>
    </div>

  </div>
</div>s