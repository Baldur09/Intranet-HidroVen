<div class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-inverse-surface/60 backdrop-blur-sm transition-all" id="modal-subdivision">
  <div class="bg-surface-container-lowest w-full max-w-md rounded-xl shadow-xl overflow-hidden flex flex-col max-h-[85vh]">
    
    <!-- Cabecera Compacta -->
    <div class="px-5 py-3.5 bg-surface-container flex items-center justify-between border-b border-surface-container-high">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-[18px]">account_tree</span>
        </div>
        <div>
          <h2 class="font-headline-sm text-sm font-bold text-on-surface leading-tight">Nueva Subdivisión</h2>
          <p class="text-[11px] text-on-surface-variant leading-none">Agrupe enlaces dentro de una pantalla existente.</p>
        </div>
      </div>
      <button aria-label="Cerrar modal" type="button" data-modal="modal-subdivision" class="btn-cerrar-modal p-1 rounded-md hover:bg-surface-container-high text-outline hover:text-on-surface transition-colors cursor-pointer">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <!-- Formulario Compacto -->
    <form id="form-subdivision" class="p-4 sm:p-5 overflow-y-auto space-y-3.5 flex-1 text-left">
      <div>
        <label class="block text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1" for="select-subdivision-pantalla">Pantalla de Destino <span class="text-error">*</span></label>
        <select id="select-subdivision-pantalla" required class="w-full px-3 py-1.5 bg-surface-container-low rounded-lg text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary border-none">
          <option value="">Seleccione Pantalla...</option>
        </select>
      </div>

      <div>
        <label class="block text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1" for="input-subdivision-nombre">Nombre de la Subdivisión <span class="text-error">*</span></label>
        <input id="input-subdivision-nombre" type="text" required placeholder="Ej. Bancos Nacionales, Billeteras Digitales..." class="w-full px-3 py-1.5 bg-surface-container-low rounded-lg text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary border-none transition-all">
      </div>
    </form>

    <!-- Pie Compacto -->
    <div class="px-5 py-2.5 bg-surface-container flex items-center justify-end gap-2 border-t border-surface-container-high">
      <button type="button" data-modal="modal-subdivision" class="btn-cerrar-modal px-3.5 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container-high text-on-surface transition-colors font-label-md text-xs cursor-pointer">
        Cancelar
      </button>
      <button type="submit" form="form-subdivision" class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-primary hover:bg-primary-container text-on-primary transition-all font-label-md text-xs shadow-sm cursor-pointer">
        <span class="material-symbols-outlined text-[16px]">save</span>
        <span>Guardar Subdivisión</span>
      </button>
    </div>

  </div>
</div>