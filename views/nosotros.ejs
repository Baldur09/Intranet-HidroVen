        <span class="material-symbols-outlined text-[16px] text-outline">chevron_right</span>
        <span class="text-primary font-semibold">Nosotros (HIDROVEN - Casa Matriz)</span>
      </nav>

      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-5">
