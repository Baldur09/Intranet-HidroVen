        </a>
        <a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 shrink-0 transition-colors" href="#mision-vision">
          <span class="material-symbols-outlined text-[16px]">visibility</span>
