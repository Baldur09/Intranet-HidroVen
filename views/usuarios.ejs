</button>
</div>
</div>

<!-- Indicadores Numéricos y Métricas (KPIs) -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
<div class="bg-surface-container-lowest p-5 rounded-xl shadow-sm flex items-center justify-between">
<div class="space-y-1">
<span class="font-label-caps text-label-caps uppercase text-tertiary">Total Registrados</span>
<div class="flex items-baseline gap-2">
<span class="font-headline-lg text-headline-lg text-on-surface" id="kpi-total-usuarios">0</span>
<span class="font-body-sm text-body-sm text-tertiary">cuentas</span>
</div>
</div>
<div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-primary">
<span class="material-symbols-outlined text-[26px]">badge</span>
</div>
</div>
<div class="bg-surface-container-lowest p-5 rounded-xl shadow-sm flex items-center justify-between">
<div class="space-y-1">
<span class="font-label-caps text-label-caps uppercase text-tertiary">Inactivos / Bajas</span>
<div class="flex items-baseline gap-2">
<span class="font-headline-lg text-headline-lg text-on-surface" id="kpi-inactivos">0</span>
<span class="font-body-sm text-body-sm text-tertiary">cuentas</span>
</div>
</div>
<div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-outline">
<span class="material-symbols-outlined text-[26px]">person_off</span>
</div>
</div>
</div>

<!-- Barra de Búsqueda, Filtrado Dinámico y Herramientas -->
<div class="bg-surface-container-lowest p-4 rounded-xl shadow-sm space-y-3">
<div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-center">
<div class="md:col-span-4 relative">
<span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
<input class="w-full pl-10 pr-4 py-2.5 bg-surface-container-low rounded-lg text-body-md font-body-md text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary transition-all" id="filtro-busqueda" placeholder="Buscar por nombre, cédula o correo..." type="text"/>
</div>
<div class="md:col-span-3">
<select class="w-full py-2.5 px-3 bg-surface-container-low rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary transition-all" id="filtro-gerencia">
<option value="todas">Todas las Gerencias</option>
</select>
</div>
<div class="md:col-span-2">
<select class="w-full py-2.5 px-3 bg-surface-container-low rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary transition-all" id="filtro-rol">
<option value="todos">Todos los Roles</option>
  </select>
</div>
<div class="md:col-span-2">
<select class="w-full py-2.5 px-3 bg-surface-container-low rounded-lg text-body-md font-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary transition-all" id="filtro-estado">
<option value="todos">Todos los Estados</option>
<option value="Activo">Activos</option>
<option value="Inactivo">Inactivos</option>
</select>
</div>
</div>
</div>

<!-- Contenedor Principal: Tabla de Personal Institucional -->
<div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col">
<div class="overflow-x-auto flex-1">
<table class="w-full text-left border-collapse">
<thead>
<tr class="bg-surface-container-low text-tertiary font-label-caps text-label-caps uppercase">
<th class="py-3.5 px-4" scope="col">Empleado</th>
<th class="py-3.5 px-4" scope="col">Cédula de Identidad</th>
<th class="py-3.5 px-4" scope="col">Gerencia / Departamento</th>
<th class="py-3.5 px-4" scope="col">Rol Institucional</th>
<th class="py-3.5 px-4" scope="col">Estado</th>
<th class="py-3.5 px-4 text-center min-w-[140px]" scope="col">Acciones</th>
</tr>
</thead>
<tbody class="text-body-md font-body-md divide-y-0" id="tabla-usuarios-cuerpo">
</tbody>
</table>
</div>

<!-- Pie de Tabla: Paginación Interactiva -->
<div class="px-5 py-3.5 bg-surface-container-low border-t border-surface-container-high flex flex-col sm:flex-row items-center justify-between gap-4">
  <div class="flex items-center gap-3 text-body-sm text-on-surface-variant">
    <span>Mostrando <span class="font-semibold text-on-surface" id="paginacion-inicio">0</span> a <span class="font-semibold text-on-surface" id="paginacion-fin">0</span> de <span class="font-semibold text-on-surface" id="paginacion-total">0</span> usuarios</span>
    <select class="py-1 pl-2 pr-7 bg-surface-container-lowest rounded-md text-body-sm border border-surface-container-high focus:outline-none focus:ring-1 focus:ring-primary" id="select-limite-pag">
      <option value="10" selected>10 por pág.</option>
      <option value="25">25 por pág.</option>
      <option value="50">50 por pág.</option>
    </select>
  </div>
  <div class="flex items-center gap-1.5" id="contenedor-botones-paginacion">
  </div>
