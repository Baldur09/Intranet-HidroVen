</button>
<button class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-lg bg-surface-container-low hover:bg-surface-container-high text-on-surface transition-all font-label-lg text-label-lg cursor-pointer flex-shrink-0 whitespace-nowrap" id="btn-editar-rapido">
<span class="material-symbols-outlined text-[18px]">edit</span>
