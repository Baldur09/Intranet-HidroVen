<script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "secondary": "#00687a",
            "background": "#f7f9fb",
            "on-background": "#191c1e",
            "inverse-surface": "#2d3133",
            "inverse-on-surface": "#eff1f3",
            "tertiary": "#545c72",
            "surface-container": "#eceef0",
            "surface-container-lowest": "#ffffff",
            "primary": "#006194",
            "primary-container": "#007bb9",
            "primary-fixed": "#cce5ff",
            "on-primary": "#ffffff",
            "on-surface": "#191c1e",
            "on-surface-variant": "#3f4850",
            "outline": "#707881",
            "surface-container-high": "#e6e8ea",
            "surface-container-highest": "#e0e3e5",
            "surface-container-low": "#f2f4f6",
            "error": "#ba1a1a",
            "error-container": "#ffdad6",
            "on-error-container": "#93000a",
            "secondary-container": "#57dffe",
            "on-secondary-fixed-variant": "#004e5c",
            "secondary-fixed": "#acedff",
            "tertiary-fixed": "#dae2fd"
          },
          spacing: {
            "margin": "2rem",
            "space-xl": "2.5rem",
            "margin-mobile": "1rem",
            "gutter-mobile": "1rem",
            "space-md": "1rem",
            "space-xs": "0.25rem",
            "gutter": "1.5rem",
            "space-lg": "1.5rem",
            "space-sm": "0.5rem"
          },
          fontFamily: {
            "headline-lg": ["Plus Jakarta Sans", "sans-serif"],
            "headline-md": ["Plus Jakarta Sans", "sans-serif"],
            "headline-sm": ["Plus Jakarta Sans", "sans-serif"],
            "display-hero": ["Plus Jakarta Sans", "sans-serif"],
            "body-lg": ["Inter", "sans-serif"],
            "body-md": ["Inter", "sans-serif"],
            "body-sm": ["Inter", "sans-serif"],
            "label-lg": ["Inter", "sans-serif"],
            "label-md": ["Inter", "sans-serif"],
            "label-caps": ["Plus Jakarta Sans", "sans-serif"]
          },
          fontSize: {
            "display-hero": ["40px", { lineHeight: "48px", letterSpacing: "-0.02em", fontWeight: "700" }],
            "label-md": ["12px", { lineHeight: "16px", fontWeight: "500" }],
            "headline-md": ["22px", { lineHeight: "28px", letterSpacing: "-0.01em", fontWeight: "600" }],
            "headline-lg-mobile": ["24px", { lineHeight: "32px", letterSpacing: "-0.01em", fontWeight: "700" }],
            "label-caps": ["11px", { lineHeight: "16px", letterSpacing: "0.06em", fontWeight: "700" }],
            "headline-sm": ["18px", { lineHeight: "24px", fontWeight: "600" }],
            "body-md": ["14px", { lineHeight: "22px", fontWeight: "400" }],
            "label-lg": ["14px", { lineHeight: "20px", fontWeight: "600" }],
            "headline-lg": ["30px", { lineHeight: "38px", letterSpacing: "-0.015em", fontWeight: "700" }],
            "body-sm": ["12px", { lineHeight: "18px", fontWeight: "400" }],
            "body-lg": ["16px", { lineHeight: "26px", fontWeight: "400" }]
          }
        }
      }
    };
  </script>
