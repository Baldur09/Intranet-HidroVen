</button>
<button class="inline-flex items-center gap-2 px-3.5 py-2.5 rounded-lg bg-surface-container-low hover:bg-error-container text-on-surface hover:text-error transition-all font-label-lg text-label-lg cursor-pointer flex-shrink-0 whitespace-nowrap" id="btn-eliminar-seleccion">
