<!DOCTYPE html>
<html lang="es" style="">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <meta content="web_standard" name="shell-type">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@600;700;800&amp;display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
  <style>
    @layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}
  </style>
  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config={"darkMode":"class","theme":{"extend":{"colors":{"secondary-fixed-dim":"#4cd7f6","surface-container-high":"#e6e8ea","on-tertiary-container":"#fefcff","on-secondary-container":"#006172","surface-variant":"#e0e3e5","on-secondary-fixed":"#001f26","tertiary-container":"#6c748b","secondary-fixed":"#acedff","surface-container-lowest":"#ffffff","outline":"#707881","on-primary-fixed":"#001d31","background":"#f7f9fb","on-surface":"#191c1e","outline-variant":"#bfc7d2","on-tertiary-fixed-variant":"#3f465c","on-secondary-fixed-variant":"#004e5c","surface-bright":"#f7f9fb","primary-fixed":"#cce5ff","surface-container":"#eceef0","on-secondary":"#ffffff","inverse-surface":"#2d3133","on-tertiary":"#ffffff","on-surface-variant":"#3f4850","on-error-container":"#93000a","on-primary":"#ffffff","on-background":"#191c1e","surface-tint":"#006398","on-tertiary-fixed":"#131b2e","surface-dim":"#d8dadc","on-primary-fixed-variant":"#004b73","on-error":"#ffffff","secondary":"#00687a","surface-container-low":"#f2f4f6","secondary-container":"#57dffe","primary-fixed-dim":"#93ccff","tertiary-fixed-dim":"#bec6e0","error":"#ba1a1a","primary-container":"#007bb9","tertiary-fixed":"#dae2fd","surface":"#f7f9fb","surface-container-highest":"#e0e3e5","inverse-on-surface":"#eff1f3","tertiary":"#545c72","primary":"#006194","on-primary-container":"#fdfcff","inverse-primary":"#93ccff","error-container":"#ffdad6"},"borderRadius":{"DEFAULT":"0.25rem","lg":"0.5rem","xl":"0.75rem","full":"9999px"},"spacing":{"margin-mobile":"1rem","space-xs":"0.25rem","gutter-mobile":"1rem","space-lg":"1.5rem","space-sm":"0.5rem","margin":"2rem","space-xl":"2.5rem","space-md":"1rem","gutter":"1.5rem"},"fontFamily":{"headline-lg-mobile":["Plus Jakarta Sans"],"label-caps":["Plus Jakarta Sans"],"headline-lg":["Plus Jakarta Sans"],"headline-md":["Plus Jakarta Sans"],"label-md":["Inter"],"label-lg":["Inter"],"body-lg":["Inter"],"body-md":["Inter"],"display-hero":["Plus Jakarta Sans"],"body-sm":["Inter"],"headline-sm":["Plus Jakarta Sans"]},"fontSize":{"headline-lg-mobile":["24px",{"lineHeight":"32px","letterSpacing":"-0.01em","fontWeight":"700"}],"label-caps":["11px",{"lineHeight":"16px","letterSpacing":"0.06em","fontWeight":"700"}],"headline-lg":["30px",{"lineHeight":"38px","letterSpacing":"-0.015em","fontWeight":"700"}],"headline-md":["22px",{"lineHeight":"28px","letterSpacing":"-0.01em","fontWeight":"600"}],"label-md":["12px",{"lineHeight":"16px","fontWeight":"500"}],"label-lg":["14px",{"lineHeight":"20px","fontWeight":"600"}],"body-lg":["16px",{"lineHeight":"26px","fontWeight":"400"}],"body-md":["14px",{"lineHeight":"22px","fontWeight":"400"}],"display-hero":["40px",{"lineHeight":"48px","letterSpacing":"-0.02em","fontWeight":"700"}],"body-sm":["12px",{"lineHeight":"18px","fontWeight":"400"}],"headline-sm":["18px",{"lineHeight":"24px","fontWeight":"600"}]}}}}
  </script>
</head>
<body class="bg-background font-body-md text-on-surface antialiased">

  <!-- INCLUSIÓN DINÁMICA DEL ENCABEZADO -->
  <%- include('partials/header') %>

  <main class="w-full pt-16 bg-background min-h-screen">
    <div class="flex flex-col w-full">
      <!-- Subtle Atmospheric Accent -->
      <div class="w-full max-w-7xl mx-auto px-margin pt-space-lg pb-space-xl">
        <!-- Top Action Breadcrumb & Session Bar -->
        <div class="flex flex-wrap items-center justify-between gap-space-md mb-space-lg">
          <div class="flex items-center gap-space-sm">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-caps text-label-caps uppercase tracking-wider shadow-sm">
              <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
              Panel de Control - Administrador
            </span>
            <span class="text-outline text-body-sm hidden sm:inline">•</span>
            <span class="text-tertiary font-body-sm text-body-sm hidden sm:inline">Servidor Central HIDRO-01</span>
          </div>
        </div>

        <!-- Main Section Header with Refined Hydro Typography -->
        <div class="relative mb-space-xl p-space-lg rounded-xl bg-surface-container-lowest shadow-sm overflow-hidden">
          <div class="absolute -right-12 -top-12 w-64 h-64 rounded-full bg-secondary-fixed/20 blur-3xl pointer-events-none"></div>
          <div class="relative z-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-space-md">
            <div>
              <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight font-bold">
                Dashboard Administrativo
              </h1>
              <p class="font-body-lg text-body-lg text-on-surface-variant mt-1 max-w-3xl">
                Gestión centralizada de módulos de contenido, usuarios y enlaces de la Intranet HidroVen.
              </p>
            </div>
          </div>
        </div>

        <!-- 3 Core Administrative Module Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter mb-space-xl">
          <!-- Módulo 1: Usuarios -->
          <div class="group relative flex flex-col justify-between p-space-lg bg-surface-container-lowest rounded-xl shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1">
            <div class="absolute top-0 left-0 right-0 h-1 bg-primary rounded-t-xl opacity-90"></div>
            <div>
              <div class="flex items-center justify-between gap-space-sm mb-space-md">
                <div class="w-14 h-14 rounded-xl bg-primary-fixed flex items-center justify-center text-primary group-hover:scale-105 transition-transform duration-300">
                  <span class="material-symbols-outlined text-[28px]" style="font-variation-settings: &quot;FILL&quot; 1;">manage_accounts</span>
                </div>
              </div>
              <h2 class="font-headline-md text-headline-md text-on-surface font-bold mb-space-xs">
                Usuarios
              </h2>
              <p class="font-body-md text-body-md text-on-surface-variant mb-space-lg leading-relaxed">
                Control de accesos, credenciales, asignación de permisos y auditoría de cuentas a nivel nacional de las filiales hidrológicas.
              </p>
              <div class="p-space-md bg-surface-container-low rounded-lg mb-space-lg flex items-center justify-between">
                <div>
                  <span class="block font-label-caps text-label-caps text-tertiary uppercase font-semibold">Estado Actual</span>
                  <div class="flex items-baseline gap-1.5 mt-0.5">
                    <span class="font-headline-lg text-headline-lg text-primary font-bold">1,420</span>
                    <span class="font-label-md text-label-md text-on-surface-variant font-medium">activos</span>
                  </div>
                </div>
                <div class="w-10 h-10 rounded-full bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed">
                  <span class="material-symbols-outlined text-[20px]">groups</span>
                </div>
              </div>
            </div>
            <a class="w-full inline-flex items-center justify-center gap-2 py-3 px-space-md bg-primary text-on-primary font-label-lg text-label-lg rounded-lg shadow-sm hover:bg-primary-container hover:text-on-primary-container transition-all" href="#">
              <span>Gestionar Usuarios</span>
              <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>

          <!-- Módulo 2: Enlaces -->
          <div class="group relative flex flex-col justify-between p-space-lg bg-surface-container-lowest rounded-xl shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1">
            <div class="absolute top-0 left-0 right-0 h-1 bg-secondary rounded-t-xl opacity-90"></div>
            <div>
              <div class="flex items-center justify-between gap-space-sm mb-space-md">
                <div class="w-14 h-14 rounded-xl bg-secondary-fixed flex items-center justify-center text-secondary group-hover:scale-105 transition-transform duration-300">
                  <span class="material-symbols-outlined text-[28px]" style="font-variation-settings: &quot;FILL&quot; 1;">link</span>
                </div>
              </div>
              <h2 class="font-headline-md text-headline-md text-on-surface font-bold mb-space-xs">
                Enlaces
              </h2>
              <p class="font-body-md text-body-md text-on-surface-variant mb-space-lg leading-relaxed">
                Configuración y administración de enlaces institucionales, banca online y organismos del Estado integrados en el ecosistema.
              </p>
              <div class="p-space-md bg-surface-container-low rounded-lg mb-space-lg flex items-center justify-between">
                <div>
                  <span class="block font-label-caps text-label-caps text-tertiary uppercase font-semibold">Integraciones</span>
                  <div class="flex items-baseline gap-1.5 mt-0.5">
                    <span class="font-headline-lg text-headline-lg text-secondary font-bold">34</span>
                    <span class="font-label-md text-label-md text-on-surface-variant font-medium">configurados</span>
                  </div>
                </div>
                <div class="w-10 h-10 rounded-full bg-secondary-fixed-dim/30 flex items-center justify-center text-on-secondary-container">
                  <span class="material-symbols-outlined text-[20px]">public</span>
                </div>
              </div>
            </div>
            <a class="w-full inline-flex items-center justify-center gap-2 py-3 px-space-md bg-secondary text-on-secondary font-label-lg text-label-lg rounded-lg shadow-sm hover:bg-on-secondary-container hover:text-surface-container-lowest transition-all" href="#">
              <span>Administrar Enlaces</span>
              <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>

          <!-- Módulo 3: Carrusel de Fotos -->
          <div class="group relative flex flex-col justify-between p-space-lg bg-surface-container-lowest rounded-xl shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-1">
            <div class="absolute top-0 left-0 right-0 h-1 bg-primary-container rounded-t-xl opacity-90"></div>
            <div>
              <div class="flex items-center justify-between gap-space-sm mb-space-md">
                <div class="w-14 h-14 rounded-xl bg-primary-fixed-dim/40 flex items-center justify-center text-primary-container group-hover:scale-105 transition-transform duration-300">
                  <span class="material-symbols-outlined text-[28px]" style="font-variation-settings: &quot;FILL&quot; 1;">view_carousel</span>
                </div>
              </div>
              <h2 class="font-headline-md text-headline-md text-on-surface font-bold mb-space-xs">
                Carrusel de Fotos
              </h2>
              <p class="font-body-md text-body-md text-on-surface-variant mb-space-lg leading-relaxed">
                Gestión multimedia, subida y orden de imágenes y banners informativos que aparecen en la página de inicio principal.
              </p>
              <div class="p-space-md bg-surface-container-low rounded-lg mb-space-lg flex items-center justify-between">
                <div>
                  <span class="block font-label-caps text-label-caps text-tertiary uppercase font-semibold">Exhibición Activa</span>
                  <div class="flex items-baseline gap-1.5 mt-0.5">
                    <span class="font-headline-lg text-headline-lg text-primary font-bold">5</span>
                    <span class="font-label-md text-label-md text-on-surface-variant font-medium">banners activos</span>
                  </div>
                </div>
                <div class="w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-primary">
                  <span class="material-symbols-outlined text-[20px]">photo_library</span>
                </div>
              </div>
            </div>
            <a class="w-full inline-flex items-center justify-center gap-2 py-3 px-space-md bg-primary text-on-primary font-label-lg text-label-lg rounded-lg shadow-sm hover:bg-primary-container hover:text-on-primary-container transition-all" href="#">
              <span>Configurar Carrusel</span>
              <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <!-- Scripts necesarios para la barra lateral y overlay -->
  <script src="/sidebar.js"></script>
  <div id="sidebar-overlay" class="hidden fixed inset-0 bg-transparent z-40 pointer-events-none" onclick="toggleSidebar()"></div>

</body>
</html>