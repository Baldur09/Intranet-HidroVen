  <!-- Notificación Flotante SIA (Toast) -->
  <div id="sia-toast" class="fixed bottom-6 right-6 z-50 hidden bg-[#006194] text-white px-5 py-3.5 rounded-xl shadow-2xl items-center gap-3 border border-white/20 transition-all">
    <span class="material-symbols-outlined text-[24px] text-secondary-container">check_circle</span>
    <div>
      <div class="font-bold text-sm leading-tight" id="sia-toast-title">Ingresando al módulo...</div>
      <div class="text-xs text-white/80" id="sia-toast-desc">Redirigiendo de forma segura</div>
    </div>
  </div>

  <!-- Scripts Interactivos -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Filtrado por Categorías
      const filterBtns = document.querySelectorAll('.filter-btn');
      const sections = {
        'trabajadores': document.getElementById('sec-trabajadores'),
        'administracion': document.getElementById('sec-administracion'),
        'tecnologia': document.getElementById('sec-tecnologia')
      };

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.dataset.filter;

          filterBtns.forEach(b => {
            b.classList.remove('bg-[#0284c7]', 'text-white', 'font-semibold', 'shadow-sm');
            b.classList.add('bg-surface-container-low', 'text-on-surface-variant', 'font-medium');
          });
          btn.classList.add('bg-[#0284c7]', 'text-white', 'font-semibold', 'shadow-sm');
          btn.classList.remove('bg-surface-container-low', 'text-on-surface-variant', 'font-medium');

          if (filter === 'all') {
            Object.values(sections).forEach(sec => sec && sec.classList.remove('hidden'));
          } else {
            Object.keys(sections).forEach(key => {
              if (sections[key]) {
                if (key === filter) {
                  sections[key].classList.remove('hidden');
                } else {
                  sections[key].classList.add('hidden');
                }
              }
            });
          }
        });
      });
    });

    // Lógica del Menú Desplegable SIA
    function toggleSiaMenu(e) {
      if (e) e.stopPropagation();
      const menu = document.getElementById('sia-dropdown-menu');
      const caret = document.getElementById('sia-caret-icon');
      if (!menu) return;

      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        if (caret) caret.style.transform = 'rotate(180deg)';
      } else {
        menu.classList.add('hidden');
        if (caret) caret.style.transform = 'rotate(0deg)';
      }
    }

    function selectSiaModule(name) {
      const menu = document.getElementById('sia-dropdown-menu');
      const caret = document.getElementById('sia-caret-icon');
      if (menu) menu.classList.add('hidden');
      if (caret) caret.style.transform = 'rotate(0deg)';

      const toast = document.getElementById('sia-toast');
      const toastTitle = document.getElementById('sia-toast-title');
      const toastDesc = document.getElementById('sia-toast-desc');

      if (toast && toastTitle && toastDesc) {
        toastTitle.textContent = 'Accediendo a: ' + name;
        toastDesc.textContent = 'Cargando entorno SIA corporativo...';
        toast.classList.remove('hidden');
        toast.classList.add('flex');
        setTimeout(() => {
          toast.classList.add('hidden');
          toast.classList.remove('flex');
        }, 3500);
      }
    }

    document.addEventListener('click', (event) => {
      const menu = document.getElementById('sia-dropdown-menu');
      const btn = document.getElementById('btn-toggle-sia');
      const caret = document.getElementById('sia-caret-icon');
      if (menu && !menu.classList.contains('hidden')) {
        if (!menu.contains(event.target) && !btn.contains(event.target)) {
          menu.classList.add('hidden');
          if (caret) caret.style.transform = 'rotate(0deg)';
        }
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        const menu = document.getElementById('sia-dropdown-menu');
        const caret = document.getElementById('sia-caret-icon');
        if (menu && !menu.classList.contains('hidden')) {
          menu.classList.add('hidden');
          if (caret) caret.style.transform = 'rotate(0deg)';
        }
      }
    });
  </script>

  <script src="/sidebar.js"></script>
