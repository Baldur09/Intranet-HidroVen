<!DOCTYPE html>
<html class="h-auto min-h-screen" lang="es">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Aplicaciones</title>

  <!-- Fuentes e Iconos -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@600;700;800&amp;display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "secondary": "#00687a",
            "background": "#f7f9fb",
            "on-background": "#191c1e",
            "inverse-surface": "#2d3133",
            "tertiary": "#545c72",
            "surface-container": "#eceef0",
            "surface-container-lowest": "#ffffff",
            "primary": "#006194",
            "primary-container": "#007bb9",
            "on-primary": "#ffffff",
            "on-surface": "#191c1e",
            "on-surface-variant": "#3f4850",
            "outline": "#707881",
            "surface-container-high": "#e6e8ea",
            "surface-container-low": "#f2f4f6"
          },
          spacing: {
            margin: "2rem",
            "margin-mobile": "1rem",
            "space-xl": "2.5rem",
            "space-lg": "1.5rem",
            "space-md": "1rem",
            "space-sm": "0.5rem",
            "space-xs": "0.25rem"
          },
          fontFamily: {
            "headline-lg": ["Plus Jakarta Sans", "sans-serif"],
            "headline-md": ["Plus Jakarta Sans", "sans-serif"],
            "headline-sm": ["Plus Jakarta Sans", "sans-serif"],
            "display-hero": ["Plus Jakarta Sans", "sans-serif"],
            "label-caps": ["Plus Jakarta Sans", "sans-serif"],
            "body-lg": ["Inter", "sans-serif"],
            "body-md": ["Inter", "sans-serif"],
            "body-sm": ["Inter", "sans-serif"],
            "label-lg": ["Inter", "sans-serif"],
            "label-md": ["Inter", "sans-serif"]
          },
          fontSize: {
            "headline-sm": ["18px", { lineHeight: "24px", fontWeight: "600" }],
            "body-sm": ["12px", { lineHeight: "18px", fontWeight: "400" }],
            "label-caps": ["11px", { lineHeight: "16px", letterSpacing: "0.06em", fontWeight: "700" }],
            "label-lg": ["14px", { lineHeight: "20px", fontWeight: "600" }]
          }
        }
      }
    };
  </script>

  <style>
    html, body {
      min-height: 100%;
      height: auto;
      overflow-y: auto !important;
      scroll-behavior: smooth;
    }
  </style>
</head>

<body class="bg-background text-on-surface antialiased font-body-md flex flex-col min-h-screen">

  <!-- Encabezado Unificado Superior -->
  <%- include('partials/header') %>

  <!-- Contenido Principal -->
  <main class="w-full flex-1 py-8 pt-20">
    <div class="max-w-[1280px] w-full mx-auto px-4 lg:px-8 space-y-8">
      
      <!-- Migas de Pan (Breadcrumb) -->
      <nav class="flex items-center gap-2 text-sm text-on-surface-variant">
        <span class="hover:text-primary transition-colors cursor-pointer">Inicio</span>
        <span class="material-symbols-outlined text-[16px] text-outline">chevron_right</span>
        <span class="text-primary font-semibold">Aplicaciones</span>
      </nav>

      <!-- Banner de Título & Filtros -->
      <div class="bg-surface-container-lowest rounded-2xl p-6 sm:p-8 lg:p-10 border border-surface-container shadow-sm space-y-6">
        <div class="max-w-3xl space-y-2">
          <h1 class="font-display-hero text-3xl sm:text-4xl text-on-surface font-extrabold tracking-tight">Aplicaciones</h1>
          <p class="font-body-lg text-base sm:text-lg text-on-surface-variant leading-relaxed">
            Plataformas internas, módulos de autoservicio y herramientas operativas diseñadas para el personal técnico y administrativo del sector hídrico.
          </p>
        </div>

        <!-- Filtros de Categorías -->
        <div class="flex items-center gap-2.5 overflow-x-auto pb-1 pt-2">
          <button class="filter-btn px-5 py-2 rounded-full bg-[#0284c7] text-white font-semibold text-sm shadow-sm transition-all whitespace-nowrap" data-filter="all">Todas</button>
          <button class="filter-btn px-5 py-2 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant font-medium text-sm transition-all whitespace-nowrap" data-filter="administracion">Administración</button>
          <button class="filter-btn px-5 py-2 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant font-medium text-sm transition-all whitespace-nowrap" data-filter="trabajadores">Trabajadores</button>
          <button class="filter-btn px-5 py-2 rounded-full bg-surface-container-low hover:bg-surface-container text-on-surface-variant font-medium text-sm transition-all whitespace-nowrap" data-filter="tecnologia">Tecnología</button>
        </div>
      </div>

      <!-- SECCIÓN 1: ADMINISTRACIÓN -->
      <section class="category-section space-y-4 pt-4" id="sec-administracion">
        <div class="flex items-center justify-between border-b border-surface-container pb-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center">
              <span class="material-symbols-outlined text-[24px]">account_balance</span>
            </div>
            <div>
              <h2 class="font-headline-md text-xl sm:text-2xl font-bold text-on-surface">Administración</h2>
              <p class="text-xs sm:text-sm text-on-surface-variant">Sistemas de gestión corporativa, nómina y compras institucionales</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Tarjeta 1: SIA -->
          <!-- Tarjeta 1: SIA -->
          <div class="bg-surface-container-lowest rounded-xl p-6 border border-surface-container shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow" id="card-sia">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-blue-50 text-[#006194] flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[26px]">hub</span>
              </div>
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <h3 class="font-headline-sm text-base font-bold text-on-surface">SIA - Sistema Integrado Administrativo</h3>
                </div>
                <p class="text-sm text-on-surface-variant leading-relaxed">Gestión presupuestaria, patrimonial y órdenes de compra.</p>
              </div>
            </div>

            <div class="pt-3 border-t border-surface-container/60 flex justify-end">
              <!-- El "relative" se pasa aquí al contenedor directo del botón para que la ventanita nazca justo debajo de su esquina izquierda -->
              <div class="relative inline-block">
                <button type="button" id="btn-toggle-sia" onclick="toggleSiaMenu(event)" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#0284c7] text-white hover:bg-[#0369a1] text-sm font-semibold transition-colors cursor-pointer shadow-sm">
                  <span>Ingresar al SIA</span>
                  <span class="material-symbols-outlined text-[16px] transition-transform duration-200" id="sia-caret-icon">arrow_drop_down</span>
                </button>

                <!-- Menú Flotante / Popover SIA (Alineado exactamente con el botón) -->
                <div id="sia-dropdown-menu" class="hidden absolute left-0 top-full mt-2 z-50 w-64 bg-white rounded-xl shadow-2xl border border-surface-container overflow-hidden transition-all">
                  <div class="p-3 bg-surface-container-low/70 border-b border-surface-container flex items-center justify-between">
                    <div>
                      <div class="font-headline-sm text-sm font-bold text-[#006194]">Módulos SIA</div>
                      <div class="text-[11px] text-tertiary">Seleccione el departamento</div>
                    </div>
                    <span class="material-symbols-outlined text-[#006194] text-[20px]">hub</span>
                  </div>

                  <div class="p-1.5 max-h-72 overflow-y-auto space-y-0.5">
                    <button type="button" onclick="selectSiaModule('Dpto de Almacen')" class="w-full flex items-center justify-between px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:text-[#0284c7] hover:bg-sky-50 rounded-lg transition-colors cursor-pointer group">
                      <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-slate-700 group-hover:text-[#0284c7]">inventory_2</span><span>Dpto de Almacen</span></span>
                      <span class="material-symbols-outlined text-[16px] text-outline opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
                    </button>
                    <button type="button" onclick="selectSiaModule('Bancos')" class="w-full flex items-center justify-between px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:text-[#0284c7] hover:bg-sky-50 rounded-lg transition-colors cursor-pointer group">
                      <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-slate-700 group-hover:text-[#0284c7]">account_balance</span><span>Bancos</span></span>
                      <span class="material-symbols-outlined text-[16px] text-outline opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
                    </button>
                    <button type="button" onclick="selectSiaModule('Dpto. de Bienes')" class="w-full flex items-center justify-between px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:text-[#0284c7] hover:bg-sky-50 rounded-lg transition-colors cursor-pointer group">
                      <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-slate-700 group-hover:text-[#0284c7]">domain</span><span>Dpto. de Bienes</span></span>
                      <span class="material-symbols-outlined text-[16px] text-outline opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
                    </button>
                    <button type="button" onclick="selectSiaModule('Dpto. de Compras')" class="w-full flex items-center justify-between px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:text-[#0284c7] hover:bg-sky-50 rounded-lg transition-colors cursor-pointer group">
                      <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-slate-700 group-hover:text-[#0284c7]">shopping_bag</span><span>Dpto. de Compras</span></span>
                      <span class="material-symbols-outlined text-[16px] text-outline opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
                    </button>
                    <button type="button" onclick="selectSiaModule('Contabilidad')" class="w-full flex items-center justify-between px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:text-[#0284c7] hover:bg-sky-50 rounded-lg transition-colors cursor-pointer group">
                      <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-slate-700 group-hover:text-[#0284c7]">calculate</span><span>Contabilidad</span></span>
                      <span class="material-symbols-outlined text-[16px] text-outline opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
                    </button>
                    <button type="button" onclick="selectSiaModule('Ingresos')" class="w-full flex items-center justify-between px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:text-[#0284c7] hover:bg-sky-50 rounded-lg transition-colors cursor-pointer group">
                      <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-slate-700 group-hover:text-[#0284c7]">trending_up</span><span>Ingresos</span></span>
                      <span class="material-symbols-outlined text-[16px] text-outline opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
                    </button>
                    <button type="button" onclick="selectSiaModule('Nomina')" class="w-full flex items-center justify-between px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:text-[#0284c7] hover:bg-sky-50 rounded-lg transition-colors cursor-pointer group">
                      <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-slate-700 group-hover:text-[#0284c7]">payments</span><span>Nomina</span></span>
                      <span class="material-symbols-outlined text-[16px] text-outline opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
                    </button>
                    <button type="button" onclick="selectSiaModule('Pagos')" class="w-full flex items-center justify-between px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:text-[#0284c7] hover:bg-sky-50 rounded-lg transition-colors cursor-pointer group">
                      <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-slate-700 group-hover:text-[#0284c7]">credit_score</span><span>Pagos</span></span>
                      <span class="material-symbols-outlined text-[16px] text-outline opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
                    </button>
                    <button type="button" onclick="selectSiaModule('Dpto. de Presupuesto')" class="w-full flex items-center justify-between px-3 py-2 text-left text-sm font-semibold text-slate-700 hover:text-[#0284c7] hover:bg-sky-50 rounded-lg transition-colors cursor-pointer group">
                      <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[18px] text-slate-700 group-hover:text-[#0284c7]">pie_chart</span><span>Dpto. de Presupuesto</span></span>
                      <span class="material-symbols-outlined text-[16px] text-outline opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span>
                    </button>
                  </div>

                  <div class="p-2 bg-surface-container-low text-center border-t border-surface-container">
                    <span class="text-[11px] text-tertiary">Autenticación SSO HidroVen</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tarjeta 2 -->
          <div class="bg-surface-container-lowest rounded-xl p-6 border border-surface-container shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-700 flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[26px]">account_balance_wallet</span>
              </div>
              <div class="space-y-1">
                <h3 class="font-headline-sm text-base font-bold text-on-surface">Nómina Banco Provincial</h3>
                <p class="text-sm text-on-surface-variant leading-relaxed">Dispersión de salarios masivos a contratistas y personal.</p>
              </div>
            </div>
            <div class="pt-3 border-t border-surface-container/60 flex justify-end">
              <a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface text-sm font-semibold transition-colors" href="#">
                <span>Acceder</span>
                <span class="material-symbols-outlined text-[16px]">open_in_new</span>
              </a>
            </div>
          </div>

          <!-- Tarjeta 3 -->
          <div class="bg-surface-container-lowest rounded-xl p-6 border border-surface-container shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[26px]">shopping_cart</span>
              </div>
              <div class="space-y-1">
                <h3 class="font-headline-sm text-base font-bold text-on-surface">E-Compras Corporativas</h3>
                <p class="text-sm text-on-surface-variant leading-relaxed">Licitaciones públicas y compras directas de insumos.</p>
              </div>
            </div>
            <div class="pt-3 border-t border-surface-container/60 flex justify-end">
              <a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface text-sm font-semibold transition-colors" href="#">
                <span>Portal de Compras</span>
                <span class="material-symbols-outlined text-[16px]">launch</span>
              </a>
            </div>
          </div>

          <!-- Tarjeta 4 -->
          <div class="bg-surface-container-lowest rounded-xl p-6 border border-surface-container shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[26px]">point_of_sale</span>
              </div>
              <div class="space-y-1">
                <h3 class="font-headline-sm text-base font-bold text-on-surface">Facturación y Cobranzas</h3>
                <p class="text-sm text-on-surface-variant leading-relaxed">Módulo de facturación institucional de servicios hídricos.</p>
              </div>
            </div>
            <div class="pt-3 border-t border-surface-container/60 flex justify-end">
              <a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface text-sm font-semibold transition-colors" href="#">
                <span>Acceder</span>
                <span class="material-symbols-outlined text-[16px]">trending_up</span>
              </a>
            </div>
          </div>

          <!-- Tarjeta 5 -->
          <div class="bg-surface-container-lowest rounded-xl p-6 border border-surface-container shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[26px]">wallet</span>
              </div>
              <div class="space-y-1">
                <h3 class="font-headline-sm text-base font-bold text-on-surface">Caja Chica y Viáticos</h3>
                <p class="text-sm text-on-surface-variant leading-relaxed">Rendición digital de gastos operativos de campo.</p>
              </div>
            </div>
            <div class="pt-3 border-t border-surface-container/60 flex justify-end">
              <a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#0284c7] text-white hover:bg-[#0369a1] text-sm font-semibold transition-colors" href="#">
                <span>Solicitar</span>
                <span class="material-symbols-outlined text-[16px]">send</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN 2: TRABAJADORES -->
      <section class="category-section space-y-4 pt-4" id="sec-trabajadores">
        <div class="flex items-center justify-between border-b border-surface-container pb-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-sky-50 text-[#006194] flex items-center justify-center">
              <span class="material-symbols-outlined text-[24px]">badge</span>
            </div>
            <div>
              <h2 class="font-headline-md text-xl sm:text-2xl font-bold text-on-surface">Trabajadores</h2>
              <p class="text-xs sm:text-sm text-on-surface-variant">Autoservicio, recibos de pago, gestiones de talento humano y solicitudes</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Tarjeta 1: Recibo de Pago -->
          <div class="bg-surface-container-lowest rounded-xl p-6 border border-surface-container shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-blue-50 text-[#006194] flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[26px]">receipt_long</span>
              </div>
              <div class="space-y-1">
                <h3 class="font-headline-sm text-base font-bold text-on-surface">Recibo de Pago</h3>
                <p class="text-sm text-on-surface-variant leading-relaxed">Consulta y descarga tus comprobantes quincenales de nómina.</p>
              </div>
            </div>
            <div class="pt-3 border-t border-surface-container/60 flex justify-end">
              <a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-[#0284c7] text-white hover:bg-[#0369a1] text-sm font-semibold transition-colors shadow-sm" href="#">
                <span>Descargar Recibo</span>
                <span class="material-symbols-outlined text-[16px]">download</span>
              </a>
            </div>
          </div>

          <!-- Tarjeta 2: Consulta de Cuentas por NIA -->
          <div class="bg-surface-container-lowest rounded-xl p-6 border border-surface-container shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[26px]">account_box</span>
              </div>
              <div class="space-y-1">
                <h3 class="font-headline-sm text-base font-bold text-on-surface">Consulta de Cuentas por NIA</h3>
                <p class="text-sm text-on-surface-variant leading-relaxed">Verificación de número de identificación administrativa y cuentas bancarias.</p>
              </div>
            </div>
            <div class="pt-3 border-t border-surface-container/60 flex justify-end">
              <a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface text-sm font-semibold transition-colors" href="#">
                <span>Consultar NIA</span>
                <span class="material-symbols-outlined text-[16px]">search</span>
              </a>
            </div>
          </div>

          <!-- Tarjeta 3: Comprobante de Retención ARC -->
          <div class="bg-surface-container-lowest rounded-xl p-6 border border-surface-container shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[26px]">request_quote</span>
              </div>
              <div class="space-y-1">
                <h3 class="font-headline-sm text-base font-bold text-on-surface">Comprobante de Retención ARC</h3>
                <p class="text-sm text-on-surface-variant leading-relaxed">Planilla oficial de ingresos percibidos y retenciones de ISLR anuales.</p>
              </div>
            </div>
            <div class="pt-3 border-t border-surface-container/60 flex justify-end">
              <a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface text-sm font-semibold transition-colors" href="#">
                <span>Obtener ARC</span>
                <span class="material-symbols-outlined text-[16px]">description</span>
              </a>
            </div>
          </div>

          <!-- Tarjeta 4: Evaluación de Desempeño -->
          <div class="bg-surface-container-lowest rounded-xl p-6 border border-surface-container shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[26px]">fact_check</span>
              </div>
              <div class="space-y-1">
                <h3 class="font-headline-sm text-base font-bold text-on-surface">Evaluación de Desempeño</h3>
