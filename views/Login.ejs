<!DOCTYPE html>
<html lang="es" style=""><%- include('partials/head', { titulo: 'Iniciar sesion | Portal Intranet', shellType: 'web_blank', headStyles: 'styles/login' }) %>
<body class="bg-background font-body-md text-on-surface min-h-screen flex flex-col justify-between selection:bg-primary-fixed selection:text-on-primary-fixed relative overflow-x-hidden">
<!-- Fondo decorativo suave minimalista -->
<div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-surface pointer-events-none -z-10"></div>
<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-primary-fixed/30 rounded-full blur-3xl pointer-events-none -z-10"></div>

<!-- Contenedor Central -->
<main class="flex-1 flex items-center justify-center w-full px-4 py-10">
<div class="w-full max-w-[420px]">
<!-- Tarjeta de Login -->
<div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/40 shadow-[0_10px_30px_rgba(0,0,0,0.06)] p-8 sm:p-9 transition-all">

<!-- Logo Institucional -->
<div class="flex flex-col items-center text-center mb-6 justify-center w-full">
  <img src="/images/Logo_Hidroven_Inicio.jpg" alt="Hidroven Logo" class="h-28 w-auto object-contain mb-3 block rounded-xl" style="transform: translate(2px, -2px);">
  <div class="flex flex-col items-center leading-none">
    <span class="font-headline-sm text-lg font-bold text-primary tracking-tight">&nbsp; SEDE LARA&nbsp;&nbsp;</span>
  </div>
  <span class="text-xs font-medium text-tertiary tracking-wide uppercase mt-0.5">INTRANET INSTITUCIONAL</span>
</div>

<!-- ================= CONTENEDOR 1: LOGIN NORMAL ================= -->
<div id="seccionLogin">
    <div class="text-center mb-6">
        <h1 class="font-headline-md text-xl font-bold text-on-surface tracking-tight">Iniciar Sesión</h1>
        <p class="font-body-sm text-xs text-on-surface-variant mt-1">Ingrese su cédula y contraseña para acceder a la intranet</p>
    </div>

    <form class="space-y-4" id="loginForm">
    <!-- Alerta Roja Mejorada -->
    <div id="mensajeError" role="alert" class="hidden flex items-start gap-3 p-3.5 rounded-xl bg-red-50/90 border border-red-200 border-l-4 border-l-red-600 text-left shadow-sm transition-all duration-200">
    <div class="p-1.5 rounded-lg bg-red-100 text-red-600 shrink-0 mt-0.5">
        <span class="material-symbols-outlined text-[18px] block">block</span>
    </div>
    <div class="flex-1 min-w-0">
        <p id="tituloError" class="text-xs font-bold text-red-900 leading-tight">Acceso restringido</p>
        <p id="textoError" class="text-[11.5px] font-medium text-red-700 mt-0.5 leading-snug"></p>
    </div>
    <button type="button" onclick="document.getElementById('mensajeError').classList.add('hidden')" class="text-red-400 hover:text-red-700 transition-colors p-0.5 rounded-lg" title="Cerrar aviso">
        <span class="material-symbols-outlined text-[16px] block">close</span>
    </button>
</div>
        <!-- Campo Cédula -->
        <div class="space-y-1.5">
            <label class="block font-label-md text-xs font-semibold text-on-surface" for="usuario">Cédula de Identidad</label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">badge</span>
                <input autocomplete="username" class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm transition-all duration-150 outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="usuario" name="usuario" placeholder="Ej. V-12.345.678" required type="text">
            </div>
        </div>

        <!-- Campo Contraseña -->
        <div class="space-y-1.5">
            <div class="flex items-center justify-between">
                <label class="font-label-md text-xs font-semibold text-on-surface" for="password">Contraseña</label>
            </div>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">lock</span>
                <input autocomplete="current-password" class="w-full pl-10 pr-10 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm transition-all duration-150 outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="password" name="password" placeholder="••••••••••••" required type="password">
                <button class="absolute right-3 p-1 rounded text-tertiary hover:text-on-surface transition-colors focus:outline-none" id="togglePassword" onclick="togglePasswordVisibility('password', 'eyeIcon')" title="Mostrar u ocultar contraseña" type="button">
                    <span class="material-symbols-outlined text-[18px] block" id="eyeIcon">visibility</span>
                </button>
            </div>
        </div>

        <button class="w-full mt-2 py-3 px-4 rounded-lg bg-primary hover:bg-[#005691] text-on-primary font-label-lg text-sm font-semibold flex items-center justify-center gap-2 shadow-sm hover:shadow-md transition-all duration-200 active:scale-[0.99]" id="btnSubmit" type="submit">
            <span>Iniciar Sesión</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </button>
    </form>
</div>

<!-- ================= CONTENEDOR 2: CAMBIO OBLIGATORIO (OCULTO INICIALMENTE) ================= -->
<div id="seccionCambioClave" class="hidden space-y-4">
    <div class="text-center mb-4">
        <h1 class="font-headline-md text-xl font-bold text-on-surface tracking-tight">Actualización Requerida</h1>
        <p class="font-body-sm text-xs text-amber-700 bg-amber-50 p-2.5 rounded-lg border border-amber-200 mt-2">
            <strong>Primer ingreso detectado:</strong> Por seguridad, debe establecer una contraseña personal antes de continuar.
        </p>
    </div>

    <form class="space-y-4" id="formCambioClave">
        <div id="mensajeErrorCambio" class="hidden text-error text-xs font-semibold text-center bg-error-container p-2.5 rounded-lg"></div>
        <div id="mensajeExitoCambio" class="hidden text-emerald-800 text-xs font-semibold text-center bg-emerald-50 p-2.5 rounded-lg border border-emerald-200"></div>

        <input type="hidden" id="tempUserId">

        <!-- Nueva Contraseña -->
        <div class="space-y-1.5">
            <label class="block font-label-md text-xs font-semibold text-on-surface" for="nuevaPassword">Nueva Contraseña</label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">lock_reset</span>
                <input class="w-full pl-10 pr-10 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="nuevaPassword" placeholder="Mínimo 8 caracteres" required minlength="8" type="password">
            </div>
        </div>

        <!-- Confirmar Contraseña -->
        <div class="space-y-1.5">
            <label class="block font-label-md text-xs font-semibold text-on-surface" for="confirmarPassword">Confirmar Nueva Contraseña</label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">lock_reset</span>
                <input class="w-full pl-10 pr-10 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="confirmarPassword" placeholder="Repite tu contraseña" required minlength="8" type="password">
            </div>
        </div>

        <button class="w-full mt-2 py-3 px-4 rounded-lg bg-primary hover:bg-[#005691] text-on-primary font-label-lg text-sm font-semibold flex items-center justify-center gap-2 shadow-sm transition-all" id="btnSubmitCambio" type="submit">
            <span>Guardar y Acceder</span>
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
        </button>
    </form>
</div>

</div>
</div>
</main>

<!-- Pie de página minimalista -->
<footer class="w-full py-5 px-4 text-center">
<div class="flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:gap-3 text-xs text-tertiary">
<span class="">© 2026 HIDROVEN - Casa Matriz del Agua Potable. Todos los derechos reservados.</span>
</div>
</footer>

<script>
    // Función para alternar visibilidad de contraseñas
    function togglePasswordVisibility(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.textContent = 'visibility_off';
        } else {
            input.type = 'password';
            icon.textContent = 'visibility';
        }
    }

    // 1. Envío del Formulario de Login
   // Función auxiliar para mostrar la alerta roja con estilo
    function mostrarErrorLogin(mensaje) {
        const divError = document.getElementById('mensajeError');
        const tituloError = document.getElementById('tituloError');
        const textoError = document.getElementById('textoError');

        if (mensaje.toLowerCase().includes('inactivo')) {
            tituloError.textContent = 'Cuenta Inactiva';
        } else {
            tituloError.textContent = 'No se pudo iniciar sesión';
        }

        textoError.textContent = mensaje;
        divError.classList.remove('hidden');

        divError.classList.remove('animate-pulse');
        void divError.offsetWidth;
        divError.classList.add('animate-pulse');
        setTimeout(() => divError.classList.remove('animate-pulse'), 600);
    }

    // 1. Envío del Formulario de Login
  // Función auxiliar para mostrar la alerta roja con estilo
    function mostrarErrorLogin(mensaje) {
        const divError = document.getElementById('mensajeError');
        const tituloError = document.getElementById('tituloError');
        const textoError = document.getElementById('textoError');

        // Personalizamos el título según el tipo de error
        if (mensaje.toLowerCase().includes('inactivo')) {
            tituloError.textContent = 'Cuenta Inactiva';
        } else {
            tituloError.textContent = 'No se pudo iniciar sesión';
        }

        textoError.textContent = mensaje;
        divError.classList.remove('hidden');

        // Pequeña animación de pulso para llamar la atención si ya estaba visible
        divError.classList.remove('animate-pulse');
        void divError.offsetWidth; // Reinicia el flujo de animación
        divError.classList.add('animate-pulse');
        setTimeout(() => divError.classList.remove('animate-pulse'), 600);
    }

    // 1. Envío del Formulario de Login
    document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const usuario = document.getElementById('usuario').value;
        const password = document.getElementById('password').value;
        const divError = document.getElementById('mensajeError');
        const btn = document.getElementById('btnSubmit');

        divError.classList.add('hidden');
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span><span>Verificando...</span>';

        try {
            const respuesta = await fetch('/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ usuario, password })
            });
            const resultado = await respuesta.json();

            if (resultado.success) {
                if (resultado.requiereCambioClave) {
                    document.getElementById('seccionLogin').classList.add('hidden');
                    document.getElementById('seccionCambioClave').classList.remove('hidden');
                    document.getElementById('tempUserId').value = resultado.userId;
                } else {
                    window.location.href = '/inicio';
                }
            } else {
                mostrarErrorLogin(resultado.message);
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        } catch (error) {
            console.error(error);
            mostrarErrorLogin('Ocurrió un error de conexión con el servidor.');
            btn.disabled = false;
            btn.innerHTML = originalText;
        }
    });
    // 2. Envío del Formulario de Cambio Obligatorio de Contraseña
    document.getElementById('formCambioClave').addEventListener('submit', async (e) => {
        e.preventDefault();
        const userId = document.getElementById('tempUserId').value;
        const nuevaPassword = document.getElementById('nuevaPassword').value;
        const confirmarPassword = document.getElementById('confirmarPassword').value;
        const divError = document.getElementById('mensajeErrorCambio');
        const divExito = document.getElementById('mensajeExitoCambio');
        const btn = document.getElementById('btnSubmitCambio');

        divError.classList.add('hidden');
        divExito.classList.add('hidden');

        if (nuevaPassword !== confirmarPassword) {
            divError.textContent = 'Las nuevas contraseñas no coinciden.';
            divError.classList.remove('hidden');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span><span>Guardando...</span>';

        try {
            const respuesta = await fetch('/api/actualizar-clave-inicial', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId, nuevaPassword, confirmarPassword })
            });
            const resultado = await respuesta.json();

            if (resultado.success) {
                divExito.textContent = resultado.message;
                divExito.classList.remove('hidden');
                // Después de 3 segundos, limpiamos y recargamos para que inicie sesión normalmente
                setTimeout(() => {
                    window.location.reload();
                }, 3500);
            } else {
                divError.textContent = resultado.message;
                divError.classList.remove('hidden');
                btn.disabled = false;
                btn.innerHTML = '<span>Guardar y Acceder</span><span class="material-symbols-outlined text-[18px]">check_circle</span>';
            }
        } catch (error) {
            console.error(error);
            divError.textContent = 'Error de conexión con el servidor.';
            divError.classList.remove('hidden');
            btn.disabled = false;
            btn.innerHTML = '<span>Guardar y Acceder</span><span class="material-symbols-outlined text-[18px]">check_circle</span>';
        }
    });
</script>

</body></html>