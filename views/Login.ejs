<!DOCTYPE html>
<html lang="es" style=""><%- include('partials/head', { titulo: 'Iniciar sesion | Portal Intranet', shellType: 'web_blank', headStyles: 'styles/login' }) %>
<body class="bg-background font-body-md text-on-surface min-h-screen flex flex-col justify-between selection:bg-primary-fixed selection:text-on-primary-fixed relative overflow-x-hidden">
<!-- Fondo decorativo suave minimalista -->
<div class="absolute inset-0 bg-gradient-to-b from-primary/5 via-transparent to-surface pointer-events-none -z-10"></div>
<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-primary-fixed/30 rounded-full blur-3xl pointer-events-none -z-10"></div>

<!-- Contenedor Central -->
<main class="flex-1 flex items-center justify-center w-full px-4 py-10">
<div class="w-full max-w-[420px]">
<!-- Tarjeta de Login -->
<div class="bg-surface-container-lowest rounded-2xl border border-outline-variant/40 shadow-[0_10px_30px_rgba(0,0,0,0.06)] p-8 sm:p-9 transition-all">

<!-- Logo Institucional -->
<div class="flex flex-col items-center text-center mb-6 justify-center w-full">
  <img src="/images/Logo_Hidroven_Inicio.jpg" alt="Hidroven Logo" class="h-28 w-auto object-contain mb-3 block rounded-xl" style="transform: translate(2px, -2px);">
  <div class="flex flex-col items-center leading-none">
    <span class="font-headline-sm text-lg font-bold text-primary tracking-tight">&nbsp; SEDE LARA&nbsp;&nbsp;</span>
  </div>
  <span class="text-xs font-medium text-tertiary tracking-wide uppercase mt-0.5">INTRANET INSTITUCIONAL</span>
</div>

<!-- ================= CONTENEDOR 1: LOGIN NORMAL ================= -->
<div id="seccionLogin">
    <div class="text-center mb-6">
        <h1 class="font-headline-md text-xl font-bold text-on-surface tracking-tight">Iniciar Sesión</h1>
        <p class="font-body-sm text-xs text-on-surface-variant mt-1">Ingrese su cédula y contraseña para acceder a la intranet</p>
    </div>

    <form class="space-y-4" id="loginForm">
    <!-- Alerta Roja Mejorada -->
    <div id="mensajeError" role="alert" class="hidden flex items-start gap-3 p-3.5 rounded-xl bg-red-50/90 border border-red-200 border-l-4 border-l-red-600 text-left shadow-sm transition-all duration-200">
    <div class="p-1.5 rounded-lg bg-red-100 text-red-600 shrink-0 mt-0.5">
        <span class="material-symbols-outlined text-[18px] block">block</span>
    </div>
    <div class="flex-1 min-w-0">
        <p id="tituloError" class="text-xs font-bold text-red-900 leading-tight">Acceso restringido</p>
        <p id="textoError" class="text-[11.5px] font-medium text-red-700 mt-0.5 leading-snug"></p>
    </div>
    <button type="button" onclick="document.getElementById('mensajeError').classList.add('hidden')" class="text-red-400 hover:text-red-700 transition-colors p-0.5 rounded-lg" title="Cerrar aviso">
        <span class="material-symbols-outlined text-[16px] block">close</span>
    </button>
</div>
        <!-- Campo Cédula -->
        <div class="space-y-1.5">
            <label class="block font-label-md text-xs font-semibold text-on-surface" for="usuario">Cédula de Identidad</label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">badge</span>
                <input autocomplete="username" class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm transition-all duration-150 outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="usuario" name="usuario" placeholder="Ej. V-12.345.678" required type="text">
            </div>
        </div>

        <!-- Campo Contraseña -->
        <div class="space-y-1.5">
            <div class="flex items-center justify-between gap-2">
                <label class="font-label-md text-xs font-semibold text-on-surface" for="password">Contraseña</label>
                <button type="button" id="btnAbrirRecuperar" class="text-[11.5px] font-semibold text-primary hover:underline focus:outline-none">
                    ¿Olvidaste tu contraseña?
                </button>
            </div>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">lock</span>
                <input autocomplete="current-password" class="w-full pl-10 pr-10 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm transition-all duration-150 outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="password" name="password" placeholder="••••••••••••" required type="password">
                <button class="absolute right-3 p-1 rounded text-tertiary hover:text-on-surface transition-colors focus:outline-none" id="togglePassword" onclick="togglePasswordVisibility('password', 'eyeIcon')" title="Mostrar u ocultar contraseña" type="button">
                    <span class="material-symbols-outlined text-[18px] block" id="eyeIcon">visibility</span>
                </button>
            </div>
        </div>

        <button class="w-full mt-2 py-3 px-4 rounded-lg bg-primary hover:bg-[#005691] text-on-primary font-label-lg text-sm font-semibold flex items-center justify-center gap-2 shadow-sm hover:shadow-md transition-all duration-200 active:scale-[0.99]" id="btnSubmit" type="submit">
            <span>Iniciar Sesión</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </button>
    </form>
</div>

<!-- ================= CONTENEDOR 2: CAMBIO OBLIGATORIO (OCULTO INICIALMENTE) ================= -->
<div id="seccionCambioClave" class="hidden space-y-4">
    <div class="text-center mb-4">
        <h1 class="font-headline-md text-xl font-bold text-on-surface tracking-tight">Actualización Requerida</h1>
        <p class="font-body-sm text-xs text-amber-700 bg-amber-50 p-2.5 rounded-lg border border-amber-200 mt-2">
            <strong>Primer ingreso detectado:</strong> Por seguridad, debe establecer una contraseña personal antes de continuar.
        </p>
    </div>

    <form class="space-y-4" id="formCambioClave">
        <div id="mensajeErrorCambio" class="hidden text-error text-xs font-semibold text-center bg-error-container p-2.5 rounded-lg"></div>
        <div id="mensajeExitoCambio" class="hidden text-emerald-800 text-xs font-semibold text-center bg-emerald-50 p-2.5 rounded-lg border border-emerald-200"></div>

        <input type="hidden" id="tempUserId">

        <!-- Nueva Contraseña -->
        <div class="space-y-1.5">
            <label class="block font-label-md text-xs font-semibold text-on-surface" for="nuevaPassword">Nueva Contraseña</label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">lock_reset</span>
                <input class="w-full pl-10 pr-10 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="nuevaPassword" placeholder="Mínimo 8 caracteres" required minlength="8" type="password">
            </div>
        </div>

        <!-- Confirmar Contraseña -->
        <div class="space-y-1.5">
            <label class="block font-label-md text-xs font-semibold text-on-surface" for="confirmarPassword">Confirmar Nueva Contraseña</label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">lock_reset</span>
                <input class="w-full pl-10 pr-10 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="confirmarPassword" placeholder="Repite tu contraseña" required minlength="8" type="password">
            </div>
        </div>

        <button class="w-full mt-2 py-3 px-4 rounded-lg bg-primary hover:bg-[#005691] text-on-primary font-label-lg text-sm font-semibold flex items-center justify-center gap-2 shadow-sm transition-all" id="btnSubmitCambio" type="submit">
            <span>Guardar y Acceder</span>
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
        </button>
    </form>
</div>

<!-- ================= CONTENEDOR 3: RECUPERAR CONTRASEÑA (OCULTO INICIALMENTE) ================= -->
<div id="seccionRecuperarClave" class="hidden space-y-4">
    <div class="text-center mb-3">
        <h1 class="font-headline-md text-xl font-bold text-on-surface tracking-tight">Recuperar Contraseña</h1>
        <p id="subtituloRecuperar" class="font-body-sm text-xs text-on-surface-variant mt-1">
            Verifica tu cédula y los últimos 4 dígitos de tu teléfono
        </p>
    </div>

    <div id="mensajeErrorRecuperar" class="hidden text-xs font-semibold text-red-700 bg-red-50 border border-red-200 p-2.5 rounded-lg"></div>
    <div id="mensajeInfoRecuperar" class="hidden text-xs font-semibold text-primary bg-primary-fixed/30 border border-primary/20 p-2.5 rounded-lg"></div>
    <div id="mensajeExitoRecuperar" class="hidden text-xs font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 p-2.5 rounded-lg"></div>

    <!-- PASO 1: Cédula + últimos 4 dígitos del teléfono -->
    <form id="formRecPaso1" class="space-y-3.5">
        <div class="space-y-1.5">
            <label class="block font-label-md text-xs font-semibold text-on-surface" for="recCedula">Cédula de Identidad</label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">badge</span>
                <input class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="recCedula" placeholder="Ej. 12345678" required type="text">
            </div>
        </div>

        <div class="space-y-1.5">
            <label class="block font-label-md text-xs font-semibold text-on-surface" for="recUltimos4">Últimos 4 dígitos del teléfono</label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">phone_iphone</span>
                <input class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="recUltimos4" placeholder="Ej. 3636" maxlength="4" minlength="4" required type="text" inputmode="numeric">
            </div>
        </div>

        <button class="w-full py-3 px-4 rounded-lg bg-primary hover:bg-[#005691] text-on-primary font-label-lg text-sm font-semibold flex items-center justify-center gap-2 shadow-sm transition-all" id="btnRecPaso1" type="submit">
            <span>Continuar</span>
            <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </button>
    </form>

    <!-- PASO 1B: Solo si el empleado no tiene correo registrado -->
    <form id="formRecCorreoNuevo" class="hidden space-y-3.5">
        <div class="space-y-1.5">
            <label class="block font-label-md text-xs font-semibold text-on-surface" for="recCorreoNuevo">Correo electrónico para recibir el código</label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">mail</span>
                <input class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="recCorreoNuevo" placeholder="correo@ejemplo.com" required type="email">
            </div>
        </div>

        <button class="w-full py-3 px-4 rounded-lg bg-primary hover:bg-[#005691] text-on-primary font-label-lg text-sm font-semibold flex items-center justify-center gap-2 shadow-sm transition-all" id="btnRecCorreoNuevo" type="submit">
            <span>Enviar Código de 6 Dígitos</span>
            <span class="material-symbols-outlined text-[18px]">send</span>
        </button>
    </form>

    <!-- PASO 2: Código de 6 dígitos -->
    <form id="formRecCodigo" class="hidden space-y-3.5">
        <div class="space-y-1.5">
            <label class="block font-label-md text-xs font-semibold text-on-surface" for="recCodigo">Código de 6 dígitos</label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">pin</span>
                <input class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm tracking-[0.25em] font-semibold outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="recCodigo" placeholder="000000" maxlength="6" minlength="6" required type="text" inputmode="numeric">
            </div>
        </div>

        <button class="w-full py-3 px-4 rounded-lg bg-primary hover:bg-[#005691] text-on-primary font-label-lg text-sm font-semibold flex items-center justify-center gap-2 shadow-sm transition-all" id="btnRecCodigo" type="submit">
            <span>Verificar Código</span>
            <span class="material-symbols-outlined text-[18px]">verified</span>
        </button>
    </form>

    <!-- PASO 3: Nueva contraseña -->
    <form id="formRecNuevaClave" class="hidden space-y-3.5">
        <div class="space-y-1.5">
            <label class="block font-label-md text-xs font-semibold text-on-surface" for="recNuevaPassword">Nueva Contraseña</label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">lock_reset</span>
                <input class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="recNuevaPassword" placeholder="Mínimo 8 caracteres" minlength="8" required type="password">
            </div>
        </div>

        <div class="space-y-1.5">
            <label class="block font-label-md text-xs font-semibold text-on-surface" for="recConfirmarPassword">Confirmar Nueva Contraseña</label>
            <div class="relative flex items-center">
                <span class="material-symbols-outlined absolute left-3.5 text-tertiary text-[18px] pointer-events-none">lock_reset</span>
                <input class="w-full pl-10 pr-4 py-2.5 rounded-lg bg-surface-container-low border border-transparent text-on-surface placeholder:text-outline/70 font-body-sm text-sm outline-none focus:bg-surface-container-lowest focus:border-primary focus:ring-2 focus:ring-primary/20" id="recConfirmarPassword" placeholder="Repite tu contraseña" minlength="8" required type="password">
            </div>
        </div>

        <button class="w-full py-3 px-4 rounded-lg bg-primary hover:bg-[#005691] text-on-primary font-label-lg text-sm font-semibold flex items-center justify-center gap-2 shadow-sm transition-all" id="btnRecNuevaClave" type="submit">
            <span>Restablecer Contraseña</span>
            <span class="material-symbols-outlined text-[18px]">check_circle</span>
        </button>
    </form>

    <div class="pt-1 text-center">
        <button type="button" id="btnVolverLogin" class="text-xs font-semibold text-tertiary hover:text-primary transition-colors">
            ← Volver a Iniciar Sesión
        </button>
    </div>
</div>

</div>
</div>
</main>

<!-- Pie de página minimalista -->
<footer class="w-full py-5 px-4 text-center">
<div class="flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:gap-3 text-xs text-tertiary">
<span class="">© 2026 HIDROVEN - Casa Matriz del Agua Potable. Todos los derechos reservados.</span>
</div>
</footer>

<script>
    // Función para alternar visibilidad de contraseñas
    function togglePasswordVisibility(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        if (input.type === 'password') {
            input.type = 'text';
            icon.textContent = 'visibility_off';
        } else {
            input.type = 'password';
            icon.textContent = 'visibility';
        }
    }

    // Función auxiliar para mostrar la alerta roja con estilo
    function mostrarErrorLogin(mensaje) {
        const divError = document.getElementById('mensajeError');
        const tituloError = document.getElementById('tituloError');
        const textoError = document.getElementById('textoError');

        if (mensaje.toLowerCase().includes('inactivo')) {
            tituloError.textContent = 'Cuenta Inactiva';
        } else {
            tituloError.textContent = 'No se pudo iniciar sesión';
        }

        textoError.textContent = mensaje;
        divError.classList.remove('hidden');

        divError.classList.remove('animate-pulse');
        void divError.offsetWidth;
        divError.classList.add('animate-pulse');
        setTimeout(() => divError.classList.remove('animate-pulse'), 600);
    }

    // 1. Envío del Formulario de Login
    document.getElementById('loginForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const usuario = document.getElementById('usuario').value;
        const password = document.getElementById('password').value;
        const divError = document.getElementById('mensajeError');
        const btn = document.getElementById('btnSubmit');

        divError.classList.add('hidden');
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span><span>Verificando...</span>';

        try {
            const respuesta = await fetch('/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ usuario, password })
            });
            const resultado = await respuesta.json();

            if (resultado.success) {
                if (resultado.requiereCambioClave) {
                    document.getElementById('seccionLogin').classList.add('hidden');
                    document.getElementById('seccionCambioClave').classList.remove('hidden');
                    document.getElementById('tempUserId').value = resultado.userId;
                } else {
                    window.location.href = '/inicio';
                }
            } else {
                mostrarErrorLogin(resultado.message);
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        } catch (error) {
            console.error(error);
            mostrarErrorLogin('Ocurrió un error de conexión con el servidor.');
            btn.disabled = false;
            btn.innerHTML = originalText;
        }
    });

    // 2. Envío del Formulario de Cambio Obligatorio de Contraseña
    document.getElementById('formCambioClave').addEventListener('submit', async (e) => {
        e.preventDefault();
        const userId = document.getElementById('tempUserId').value;
        const nuevaPassword = document.getElementById('nuevaPassword').value;
        const confirmarPassword = document.getElementById('confirmarPassword').value;
        const divError = document.getElementById('mensajeErrorCambio');
        const divExito = document.getElementById('mensajeExitoCambio');
        const btn = document.getElementById('btnSubmitCambio');

        divError.classList.add('hidden');
        divExito.classList.add('hidden');

        if (nuevaPassword !== confirmarPassword) {
            divError.textContent = 'Las nuevas contraseñas no coinciden.';
            divError.classList.remove('hidden');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span><span>Guardando...</span>';

        try {
            const respuesta = await fetch('/api/actualizar-clave-inicial', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ userId, nuevaPassword, confirmarPassword })
            });
            const resultado = await respuesta.json();

            if (resultado.success) {
                divExito.textContent = resultado.message;
                divExito.classList.remove('hidden');
                setTimeout(() => {
                    window.location.reload();
                }, 3500);
            } else {
                divError.textContent = resultado.message;
                divError.classList.remove('hidden');
                btn.disabled = false;
                btn.innerHTML = '<span>Guardar y Acceder</span><span class="material-symbols-outlined text-[18px]">check_circle</span>';
            }
        } catch (error) {
            console.error(error);
            divError.textContent = 'Error de conexión con el servidor.';
            divError.classList.remove('hidden');
            btn.disabled = false;
            btn.innerHTML = '<span>Guardar y Acceder</span><span class="material-symbols-outlined text-[18px]">check_circle</span>';
        }
    });

    // ================= 3. FLUJO RECUPERAR CONTRASEÑA =================
    let estadoRecuperacion = {
        cedula: '',
        ultimos4: '',
        recuperacionId: null,
        codigo: ''
    };

    const errRec = document.getElementById('mensajeErrorRecuperar');
    const infoRec = document.getElementById('mensajeInfoRecuperar');
    const okRec = document.getElementById('mensajeExitoRecuperar');
    const subRec = document.getElementById('subtituloRecuperar');

    function limpiarAvisosRecuperar() {
        errRec.classList.add('hidden');
        infoRec.classList.add('hidden');
        okRec.classList.add('hidden');
        errRec.textContent = '';
        infoRec.textContent = '';
        okRec.textContent = '';
    }

    function mostrarPasoRecuperar(paso) {
        document.getElementById('formRecPaso1').classList.toggle('hidden', paso !== 'paso1');
        document.getElementById('formRecCorreoNuevo').classList.toggle('hidden', paso !== 'correoNuevo');
        document.getElementById('formRecCodigo').classList.toggle('hidden', paso !== 'codigo');
        document.getElementById('formRecNuevaClave').classList.toggle('hidden', paso !== 'nuevaClave');
    }

    function reiniciarFlujoRecuperar() {
        estadoRecuperacion = { cedula: '', ultimos4: '', recuperacionId: null, codigo: '' };
        document.getElementById('formRecPaso1').reset();
        document.getElementById('formRecCorreoNuevo').reset();
        document.getElementById('formRecCodigo').reset();
        document.getElementById('formRecNuevaClave').reset();
        subRec.textContent = 'Verifica tu cédula y los últimos 4 dígitos de tu teléfono';
        limpiarAvisosRecuperar();
        mostrarPasoRecuperar('paso1');
    }

    document.getElementById('btnAbrirRecuperar').addEventListener('click', () => {
        reiniciarFlujoRecuperar();
        document.getElementById('seccionLogin').classList.add('hidden');
        document.getElementById('seccionRecuperarClave').classList.remove('hidden');
    });

    document.getElementById('btnVolverLogin').addEventListener('click', () => {
        reiniciarFlujoRecuperar();
        document.getElementById('seccionRecuperarClave').classList.add('hidden');
        document.getElementById('seccionLogin').classList.remove('hidden');
    });

    // Paso 1: Solicitar recuperación con cédula + últimos 4 dígitos del teléfono
    document.getElementById('formRecPaso1').addEventListener('submit', async (e) => {
        e.preventDefault();
        limpiarAvisosRecuperar();

        const cedula = document.getElementById('recCedula').value.trim();
        const ultimos4 = document.getElementById('recUltimos4').value.trim();
        const btn = document.getElementById('btnRecPaso1');
        const textoOriginal = btn.innerHTML;

        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span><span>Verificando...</span>';

        try {
            const resp = await fetch('/recuperar/solicitar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cedula, ultimos4 })
            });
            const data = await resp.json();

            if (!data.success) {
                errRec.textContent = data.message;
                errRec.classList.remove('hidden');
                btn.disabled = false;
                btn.innerHTML = textoOriginal;
                return;
            }

            estadoRecuperacion.cedula = cedula;
            estadoRecuperacion.ultimos4 = ultimos4;

            if (data.requiereCorreo) {
                subRec.textContent = 'No tienes un correo registrado aún';
                infoRec.textContent = data.message;
                infoRec.classList.remove('hidden');
                mostrarPasoRecuperar('correoNuevo');
            } else {
                estadoRecuperacion.recuperacionId = data.recuperacionId;
                subRec.textContent = `Código enviado a ${data.correoEnmascarado}`;
                infoRec.textContent = data.message;
                infoRec.classList.remove('hidden');
                mostrarPasoRecuperar('codigo');
            }
        } catch (error) {
            console.error(error);
            errRec.textContent = 'Error de conexión con el servidor.';
            errRec.classList.remove('hidden');
        } finally {
            btn.disabled = false;
            btn.innerHTML = textoOriginal;
        }
    });

    // Paso 1B: Enviar código a correo nuevo (cuando el empleado no tenía correo)
    document.getElementById('formRecCorreoNuevo').addEventListener('submit', async (e) => {
        e.preventDefault();
        limpiarAvisosRecuperar();

        const correo = document.getElementById('recCorreoNuevo').value.trim();
        const btn = document.getElementById('btnRecCorreoNuevo');
        const textoOriginal = btn.innerHTML;

        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span><span>Enviando...</span>';

        try {
            const resp = await fetch('/recuperar/correo-nuevo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    cedula: estadoRecuperacion.cedula,
                    ultimos4: estadoRecuperacion.ultimos4,
                    correo
                })
            });
            const data = await resp.json();

            if (!data.success) {
                errRec.textContent = data.message;
                errRec.classList.remove('hidden');
            } else {
                estadoRecuperacion.recuperacionId = data.recuperacionId;
                subRec.textContent = `Código enviado a ${data.correoEnmascarado}`;
                infoRec.textContent = data.message;
                infoRec.classList.remove('hidden');
                mostrarPasoRecuperar('codigo');
            }
        } catch (error) {
            console.error(error);
            errRec.textContent = 'Error de conexión con el servidor.';
            errRec.classList.remove('hidden');
        } finally {
            btn.disabled = false;
            btn.innerHTML = textoOriginal;
        }
    });

    // Paso 2: Verificar código OTP de 6 dígitos
    document.getElementById('formRecCodigo').addEventListener('submit', async (e) => {
        e.preventDefault();
        limpiarAvisosRecuperar();

        const codigo = document.getElementById('recCodigo').value.trim();
        const btn = document.getElementById('btnRecCodigo');
        const textoOriginal = btn.innerHTML;

        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span><span>Validando...</span>';

        try {
            const resp = await fetch('/recuperar/verificar-codigo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    recuperacionId: estadoRecuperacion.recuperacionId,
                    codigo
                })
            });
            const data = await resp.json();

            if (!data.success) {
                errRec.textContent = data.message;
                errRec.classList.remove('hidden');
            } else {
                estadoRecuperacion.codigo = codigo;
                subRec.textContent = 'Establece tu nueva contraseña';
                infoRec.textContent = data.message;
                infoRec.classList.remove('hidden');
                mostrarPasoRecuperar('nuevaClave');
            }
        } catch (error) {
            console.error(error);
            errRec.textContent = 'Error de conexión con el servidor.';
            errRec.classList.remove('hidden');
        } finally {
            btn.disabled = false;
            btn.innerHTML = textoOriginal;
        }
    });

    // Paso 3: Restablecer contraseña
    document.getElementById('formRecNuevaClave').addEventListener('submit', async (e) => {
        e.preventDefault();
        limpiarAvisosRecuperar();

        const nuevaPassword = document.getElementById('recNuevaPassword').value;
        const confirmarPassword = document.getElementById('recConfirmarPassword').value;

        if (nuevaPassword !== confirmarPassword) {
            errRec.textContent = 'Las contraseñas no coinciden.';
            errRec.classList.remove('hidden');
            return;
        }

        const btn = document.getElementById('btnRecNuevaClave');
        const textoOriginal = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[18px]">sync</span><span>Guardando...</span>';

        try {
            const resp = await fetch('/recuperar/restablecer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    recuperacionId: estadoRecuperacion.recuperacionId,
                    codigo: estadoRecuperacion.codigo,
                    nuevaPassword,
                    confirmarPassword
                })
            });
            const data = await resp.json();

            if (!data.success) {
                errRec.textContent = data.message;
                errRec.classList.remove('hidden');
                btn.disabled = false;
                btn.innerHTML = textoOriginal;
            } else {
                okRec.textContent = data.message;
                okRec.classList.remove('hidden');
                mostrarPasoRecuperar('ninguno');
                setTimeout(() => {
                    reiniciarFlujoRecuperar();
                    document.getElementById('seccionRecuperarClave').classList.add('hidden');
                    document.getElementById('seccionLogin').classList.remove('hidden');
                }, 2500);
            }
        } catch (error) {
            console.error(error);
            errRec.textContent = 'Error de conexión con el servidor.';
            errRec.classList.remove('hidden');
            btn.disabled = false;
            btn.innerHTML = textoOriginal;
        }
    });
</script>

</body></html>
