          <span class="material-symbols-outlined text-[18px]">check_circle</span>
        </div>
        <div class="flex flex-col">
          <span id="toast-title" class="font-label-lg text-label-lg font-semibold">Copiado con éxito</span>
          <span id="toast-msg" class="font-body-sm text-body-sm opacity-80">Extensión copiada al portapapeles</span>
        </div>
      </div>

